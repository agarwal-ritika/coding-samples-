ector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Do you have any religious believes?","Choices":{"1":{"Display":"Yes"},"2":{"Display":"No"}},"ChoiceOrder":["1","2"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID221"}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID222","SecondaryAttribute":"Please indicate your religious belief","TertiaryAttribute":null,"Payload":{"QuestionText":"Please indicate your religious belief","DefaultChoices":false,"DataExportTag":"religion_2","QuestionID":"QID222","QuestionType":"TE","Selector":"SL","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please indicate your religious belief","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"DisplayLogic":{"0":{"0":{"LogicType":"Question","QuestionID":"QID221","QuestionIsInLoop":"no","ChoiceLocator":"q:\/\/QID221\/SelectableChoice\/1","Operator":"Selected","QuestionIDFromLocator":"QID221","LeftOperand":"q:\/\/QID221\/SelectableChoice\/1","Type":"Expression","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Do you have any religious believes?<\/span> <span class=\"LeftOpDesc\">Yes<\/span> <span class=\"OpDesc\">Is Selected<\/span> "},"Type":"If"},"Type":"BooleanExpression","inPage":false}}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID223","SecondaryAttribute":"Over the past week, how often do you check news or information about COVID-19?","TertiaryAttribute":null,"Payload":{"QuestionText":"Over the past week, how often do you check news or information about COVID-19?","DefaultChoices":false,"DataExportTag":"information freq","QuestionID":"QID223","QuestionType":"Slider","Selector":"HSLIDER","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","CSSliderMin":1,"CSSliderMax":7,"GridLines":6,"SnapToGrid":false,"NumDecimals":"0","ShowValue":true,"CustomStart":true,"NotApplicable":false,"MobileFirst":true,"SliderStartPositions":{"1":0}},"QuestionDescription":"Over the past week, how often do you check news or information about COVID-19?","Choices":{"1":{"Display":""}},"ChoiceOrder":["1"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":3,"Labels":{"1":{"Display":"very rarely"},"2":{"Display":"very often"}}}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID224","SecondaryAttribute":"What is your height (in meters) and weight (in kilograms)","TertiaryAttribute":null,"Payload":{"QuestionText":"What is your height (in meters) and weight (in kilograms)","DefaultChoices":false,"DataExportTag":"height weight","QuestionType":"TE","Selector":"FORM","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"What is your height (in meters) and weight (in kilograms)","Choices":{"4":{"Display":"Height","InputHeight":29,"InputWidth":88,"TextEntry":"on"},"5":{"Display":"Weight","InputHeight":29,"InputWidth":88,"TextEntry":"on"}},"ChoiceOrder":["4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":null}},"GradingData":[],"Language":[],"NextChoiceId":14,"NextAnswerId":25,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID224","DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID225","SecondaryAttribute":"In this part of the study, we are interested in your \u201cFood Preferences\u201d Most modern theories of ","TertiaryAttribute":null,"Payload":{"QuestionText":"<p style=\"text-align: center;\">In this part of the study, we are interested in your<\/p><p style=\"text-align: center;\"><br><\/p>\n\n<p style=\"text-align: center;\"><a href=\"#1\">\u201cFood Preferences\u201d<\/a><\/p><p style=\"text-align: center;\"><br><\/p>\n\n<p style=\"text-align: center;\">Most modern theories of consumption recognize the fact that decisions do not take place in a vacuum. Individual preferences and knowledge, along with situational variables can greatly impact the decision process. In order to facilitate our research on food consumption, we are interested in knowing certain factors about you, the consumer. Specifically, we are interested in whether you actually take time to read the directions; if not, then some of our manipulations that rely on changes in the instructions will be ineffective. So, in order to demonstrate that you have read the instructions, please ignore the link above and most of the different foods listed below. Instead, simply click \"Evian\" from the option below. Thank you very much.<\/p>","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n\/*Place Your Javascript Below This Line*\/\nthis.questionclick = function(event,element){ \n\/\/ \nif (element.type == 'checkbox') \n{ \nthis.clickNextButton();\n} \n}\n});","QuestionType":"MC","Selector":"MAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"In this part of the study, we are interested in your \u201cFood Preferences\u201d Most modern theories of c...","Choices":{"15":{"Display":"MM's"},"16":{"Display":"Jelly Beans"},"17":{"Display":"Hershey's Kisses"},"18":{"Display":"Coca Cola"},"19":{"Display":"Evian"},"20":{"Display":"Pepsi"}},"ChoiceOrder":["15","16","17","18","19","20"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"Language":[],"DataVisibility":{"Private":false,"Hidden":false},"QuestionText_Unsafe":"<style type=\"text\/css\">.Skin #Buttons {\nvisibility:hidden;\n}\n<\/style>\n<p style=\"text-align: center;\">In this part of the study we are interested in your<\/p>\n\n<p style=\"text-align: center;\"><a href=\"#1\" onclick=\"Qualtrics.SurveyEngine.navClick(event, 'NextButton')\">\u201cFood Preferences\u201d<\/a><\/p>\n\n<p>&nbsp;<\/p>\n\n<p style=\"text-align: center;\">Most modern theories of consumption recognize the fact that decisions do not take place in a vacuum. Individual preferences and knowledge, along with situational variables can greatly impact the decision process. In order to facilitate our research on food consumption we are interested in knowing certain factors about you, the consumer. Specifically we are interested in whether you actually take time to read the directions; if not, then some of our manipulations that rely on changes in the instructions will be ineffective. So, in order to demonstrate that you have read the instructions, please ignore the the link above and most of the different foods listed below. Instead, simply click \"Evian\" from the option below. Thank you very much.<\/p>","DataExportTag":"check","QuestionID":"QID225","NextChoiceId":21,"NextAnswerId":1,"DefaultChoices":false,"GradingData":[]}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID226","SecondaryAttribute":"The next questionnaire will describe several experiences one might have encountered in one\u2018s life.","TertiaryAttribute":null,"Payload":{"QuestionText":"<div><span style=\"font-size:16px;\">The next questionnaire will describe several experiences one might have encountered in one\u2018s life time. Please indicate <strong>how often you have encountered these experiences in the past three months.<\/strong> There is no right or wrong with your answers. &nbsp;<\/span><\/div>","DefaultChoices":false,"DataExportTag":"instruction","QuestionID":"QID226","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"The next questionnaire will describe several experiences one might have encountered in one\u2018s life...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID227","SecondaryAttribute":"I experience times in which I am overwhelmed by worries\u2026","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><span lang=\"EN-US\">I experience times in which I am overwhelmed by worries\u2026<o:p><\/o:p><\/span><\/p>","DataExportTag":"Q25","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"I experience times in which I am overwhelmed by worries\u2026","Choices":{"1":{"Display":"never"},"2":{"Display":"rarely"},"3":{"Display":"sometimes"},"4":{"Display":"often"},"5":{"Display":"very often"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID227"}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID228","SecondaryAttribute":"I experience times in which I don\u2019t have the possibility to talk to other people\u2026","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><span lang=\"EN-US\">I experience times in which I don\u2019t have the possibility to talk to other people\u2026<o:p><\/o:p><\/span><\/p>","DataExportTag":"Q29","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"I experience times in which I don\u2019t have the possibility to talk to other people\u2026","Choices":{"1":{"Display":"never"},"2":{"Display":"rarely"},"3":{"Display":"sometimes"},"4":{"Display":"often"},"5":{"Display":"very often"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Langu