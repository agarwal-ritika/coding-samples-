,\n\t\t[[11.2,\t0],\t[8.4,\t2.5],   [5.6,\t5],\t[2.8,\t7.5],\t[0,\t10]],\n\t\t[[12.4,\t0],\t[9.3,\t2.5],\t[6.2,\t5],\t[3.1,\t7.5],\t[0,\t10]],\n\t\t[[14.8,\t0],\t[11.1,\t2.5],\t[7.4,\t5],\t[3.7,\t7.5],\t[0,\t10]],\n\t\t[[19.6,\t0],\t[14.7,\t2.5],\t[9.8,\t5],\t[4.9,\t7.5],\t[0,\t10]],\n\t\t[[29.2,\t0],\t[21.9,\t2.5],\t[14.6,\t5],\t[7.3,\t7.5],\t[0,\t10]],\n\t\t[[48.4,\t0],\t[36.3,\t2.5],\t[24.2,\t5],\t[12.1,\t7.5],\t[0,\t10]]\n\t];\n\n\t\n\tvar questions = [\"${q:\/\/1_QID487\/SelectedChoicesRecode}\",\n\t\t\t\t\t\"${q:\/\/2_QID487\/SelectedChoicesRecode}\",\n\t\t\t\t\t\"${q:\/\/3_QID487\/SelectedChoicesRecode}\",\n\t\t\t\t\t\"${q:\/\/4_QID487\/SelectedChoicesRecode}\",\n\t\t\t\t\t\"${q:\/\/5_QID487\/SelectedChoicesRecode}\",\n\t\t\t\t\t\"${q:\/\/6_QID487\/SelectedChoicesRecode}\",\n\t\t\t\t\t\"${q:\/\/7_QID487\/SelectedChoicesRecode}\",\n\t\t\t\t\t\"${q:\/\/8_QID487\/SelectedChoicesRecode}\",\n\t\t\t\t\t\"${q:\/\/9_QID487\/SelectedChoicesRecode}\",\n\t\t\t\t\t\"${q:\/\/10_QID487\/SelectedChoicesRecode}\",\n\t\t\t\t\t\"${q:\/\/11_QID487\/SelectedChoicesRecode}\",\n\t\t\t\t\t\"${q:\/\/12_QID487\/SelectedChoicesRecode}\",\n\t\t\t\t\t\"${q:\/\/13_QID487\/SelectedChoicesRecode}\",\n\t\t\t\t\t\"${q:\/\/14_QID487\/SelectedChoicesRecode}\"];\n\t\n\tvar bonusQuestion = Math.round(Math.random()*13);\n\tvar bonusChoice = questions[bonusQuestion];\n\t\n\tvar coin_flip = Math.round(Math.random());\n\t\n\tvar bonus = reward_matrix[bonusQuestion][bonusChoice-1][coin_flip];\n\t\n\tQualtrics.SurveyEngine.setEmbeddedData( 'bonus', bonus);\n\n});\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\t\/*Place your JavaScript here to run when the page is fully displayed*\/\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\tconsole.log(\"${e:\/\/Field\/selected_reward}\")\n\n});"}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID484","SecondaryAttribute":"\u00a0 Your bonus amount is ${e:\/\/Field\/bonus}\u20ac! \u00a0 We will pay you the money soon. Thank you for your","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\"><br><\/div>\n\n<div style=\"text-align: center;\">&nbsp;<\/div>\n\n<div style=\"text-align: center;\"><span style=\"font-size:19px;\">Your bonus amount is ${e:\/\/Field\/bonus}\u20ac!<\/span><\/div>\n\n<div style=\"text-align: center;\">&nbsp;<\/div>\n\n<div style=\"text-align: center;\"><span style=\"font-size:19px;\">We will pay you the money soon. Thank you for your participation!<\/span><\/div>","DefaultChoices":false,"DataExportTag":"Q484","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"\u00a0 Your bonus amount is ${e:\/\/Field\/bonus}\u20ac! \u00a0 We will pay you the money soon. Thank you for your...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID484","DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID485","SecondaryAttribute":"In the following task, you are going to make a series of independent decisions. Each decision inv...","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-size:16px;\">In the following task, you are going to make a series of independent decisions. Each decision involves choosing from 5 gamble options.&nbsp;<\/span>\n<div>&nbsp;<\/div>\n\n<div><span style=\"font-size:16px;\"><strong><u>Each option has different amounts of money you could earn if a coin flip shows heads or a coin flip shows tails. The coin is fair so that the probability of tossing&nbsp;heads and tails is equal (50%).<\/u><\/strong>&nbsp;<br \/>\n&nbsp;<br \/>\n<u><strong>You should examine all 5 options carefully and should choose the one that you like most.<\/strong><\/u><br \/>\n<br \/>\n<strong><u>Note that one of the trials may be selected to determine the bonus payoff to you<\/u><\/strong>. You will receive the bonus earning corresponding to your decision in that trial. For example, if you chose a gamble option that promises 5&euro; on heads and 10&euro; on tails and if the coin flip shows heads, you earn 5&euro;.&nbsp;<\/span><\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"In the following task, you are going to make a series of independent decisions. Each decision inv...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"DataVisibility":{"Private":false,"Hidden":false},"QuestionText_Unsafe":"<span style=\"font-size:16px;\">In the following task, you are going to make a series of independent decisions. Each decision involves choosing from 5 gamble options. Each option has different amounts of money you could earn if a coin flip shows heads and the amount of money you could earn if a coin flip shows tails. In other words, the winning probability is 50%.&nbsp;<br \/>\n&nbsp;<br \/>\n<strong>You should examine all 5 options carefully and should choose the one that you like most.<\/strong><br \/>\n<br \/>\nNote that one of the trials may be selected to determine the bonus payoff to you. You will receive the bonus earning corresponding to your decision in that trial. For example, if you chose a gamble option that promises 5&euro; on heads and 10&euro; on tails and if the coin flip shows heads, you earn 5&euro;.&nbsp;<\/span>","DataExportTag":"Q485","QuestionID":"QID485"}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID486","SecondaryAttribute":"Which gamble on a coin flip would you like to play? \u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\"><span style=\"font-size:16px;\">Which gamble on a coin flip would you like to play?<\/span><br \/>\n&nbsp;<\/div>","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW","Autoscale":{"YScale":{"Name":"hedonic","Type":"likert","Reverse":false}}},"QuestionDescription":"Which gamble on a coin flip would you like to play? \u00a0","Choices":{"1":{"Display":"<div style=\"text-align: center;\"><span style=\"font-size:14px;\">Heads: ${lm:\/\/Field\/1}\u20ac<br>Tails: ${lm:\/\/Field\/2}\u20ac<\/span><\/div>"},"2":{"Display":"<div style=\"text-align: center;\"><span style=\"font-size:14px;\">Heads: ${lm:\/\/Field\/3}\u20ac<br>Tails: ${lm:\/\/Field\/4}\u20ac<\/span><\/div>"},"3":{"Display":"<div style=\"text-align: center;\"><span style=\"font-size:14px;\">Heads: ${lm:\/\/Field\/5}\u20ac<br>Tails: ${lm:\/\/Field\/6}\u20ac<\/span><\/div>"},"4":{"Display":"<div style=\"text-align: center;\"><span style=\"font-size:14px;\">Heads: ${lm:\/\/Field\/7}\u20ac<br>Tails: ${lm:\/\/Field\/8}\u20ac<\/span><\/div>"},"5":{"Display":"<div style=\"text-align: center;\"><span style=\"font-size:14px;\">Heads: ${lm:\/\/Field\/9}\u20ac<br>Tails: ${lm:\/\/Field\/10}\u20ac<\/span><\/div>"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":6,"NextAnswerId":1,"DataVisibility":{"Private":false,"Hidden":false},"QuestionText_Unsafe":"<div style=\"text-align: center;\"><span style=\"font-size:16px;\">Which gamble on a coin flip would you like to play?<\/span><br \/>\n&nbsp;<\/div>","DataExportTag":"Q486","QuestionID":"QID486"}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID487","SecondaryAttribute":"Which gamble on a coin flip would you like to play? \u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\"><span style=\"font-size:16px;\">Which gamble on a coin flip would you like to play?<\/span><\/div>\n\n<div style=\"text-align: center;\">&nbsp;<\/div>","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW","Autoscale":{"YScale":{"Name":"hedonic","Type":"likert","Reverse":false}}},"QuestionDescription":"Which gamble on a coin flip would you like to play? \u00a0","Choices":{"1":{"Display":"<div style=\"text-align: center;\"><span style=\"font-size:14px;\">Heads: ${lm:\/\/Field\/1}\u20ac<br>Tails: ${lm:\/\/Field\/2}\u20ac<\/span><\/div>"},"2":{"Display":"<div style=\"text-align: center;\"><span style=\"font-size:14px;\">Heads: ${lm:\/\/Field\/3}\u20ac<br>Tails: ${lm:\/\/Field\/4}\u20ac<\/span><\/div>"},"3":{"Display":"<div style=\"text-align: center;\"><span style=\"font-size:14px;\">Heads: ${lm:\/\/Field\/5}\u20ac<br>Tails: ${lm:\/\/Field\/6}\u20ac<\/span><\/div>"},"4":{"Display":"<div style=\"text-align: center;\"><span style=\"font-size:14px;\">Heads: ${lm:\/\/Field\/7}\u20ac<br>Tails: ${lm:\/\/Field\/8}\u20ac<\/span><\/div>"},"5":{"Display":"<div style=\"text-align: center;\"><span style=\"font-size:14px;\">Heads: ${lm:\/\/Field\/9}\u20ac<br>Tails: ${lm:\/\/Field\/10}\u20ac<\/span><\/div>"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":6,"NextAnswerId":1,"DataVisibility":{"Private":false,"Hidden":false},"QuestionText_Unsafe":"Which gamble on a coin flip would you like to play?","DataExportTag":"Q487","QuestionID":"QID487"}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID488","SecondaryAttribute":"In the following task, please select the option you would like to choose. You will earn real mone...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><span style=\"font-size: 12pt; font-family: &quot;Times New Roman&quot;;\">In the following task, please select the option you would like to choose. You will earn real money, depending on your decisions. Please make careful decisions. In this experiment, you will participate in 14 independent decision problems that share a common format. In each decision problem, you will be asked to choose&nbsp;<\/span><span style=\"font-size: 12pt; font-family: &quot;Times New Roman,Bold&quot;;\">one option out of 5 options<\/span><span style=\"font-size: 12pt; font-family: &quot;Times New Roman&quot;;\">.<\/span><\/p><p><span style=\"font-size: 12pt; font-family: &quot;Times New Roman&quot;;\"><br><\/span><\/p><div><p><span style=\"font-size: 12pt; font-family: &quot;Times New Roman&quot;;\">Each option is a gamble on a coin flip. Each option indicates the amount of money you will earn if a coin flip shows heads and the amount of money you will earn if a coin flip shows tails.&nbsp;<\/span><\/p><p><span style=\"font-size: 12pt; font-family: &quot;Times New Roman&quot;;\"><br><\/span><\/p><div><p><span style=\"font-size: 12pt; font-family: &quot;Times New Roman&quot;;\">In each decision problem, you are encouraged to examine all 5 options &nbsp;and&nbsp;<\/span><span style=\"font-family: &quot;Times New Roman&quot;; font-size: 12pt;\">should choose only one option you like most.<\/span><\/p><p><span style=\"font-family: &quot;Times New Roman&quot;; font-size: 12pt;\"><br><\/span><\/p><div><div><div><p><span style=\"font-size: 12pt; font-family: &quot;Times New Roman&quot;;\">At the end of the experiment, one question out of the in total 14 questions will be randomly chosen. In the chosen question, a fair coin will be flipped (heads and tails are equally probable to show). You will receive your earnings corresponding to your decision in the chosen question. For example, if you have chosen a gamble for that question that promises 5\u20ac on heads and 10\u20ac on tails and the the coin flip shows heads, you earn 5\u20ac.<\/span><\/p><\/div><\/div><\/div><\/div><\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"In the following task, please select the option you would like to choose. You will earn real mone...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":11,"NextAnswerId":1,"DataVisibility":{"Private":false,"Hidden":false},"QuestionText_Unsafe":"<p><span style=\"font-size: 12pt; font-family: &quot;Times New Roman&quot;;\">In the following task, please select the option you would like to choose. You will earn real money, depending on your decisions. Please make careful decisions. In this experiment, you will participate in 14 independent decision problems that share a common format. In each decision problem, you will be asked to choose&nbsp;<\/span><span style=\"font-size: 12pt; font-family: &quot;Times New Roman,Bold&quot;;\">one option out of 5 options<\/span><span style=\"font-size: 12pt; font-family: &quot;Times New Roman&quot;;\">.<\/span><\/p><p><span style=\"font-size: 12pt; font-family: &quot;Times New Roman&quot;;\"><br><\/span><\/p><div><p><span style=\"font-size: 12pt; font-family: &quot;Times New Roman&quot;;\">Each option is a gamble on a coin flip. Each option indicates the amount of money you will earn if a coin flip shows heads and the amount of money you will earn if a coin flip shows tails.&nbsp;<\/span><\/p><p><span style=\"font-size: 12pt; font-family: &quot;Times New Roman&quot;;\"><br><\/span><\/p><div><p><span style=\"font-size: 12pt; font-family: &quot;Times New Roman&quot;;\">In each decision problem, you are encouraged to examine all 5 options &nbsp;and&nbsp;<\/span><span style=\"font-family: &quot;Times New Roman&quot;; font-size: 12pt;\">should choose only one option you like most.<\/span><\/p><p><span style=\"font-family: &quot;Times New Roman&quot;; font-size: 12pt;\"><br><\/span><\/p><div><div><div><p><span style=\"font-size: 12pt; font-family: &quot;Times New Roman&quot;;\">At the end of the experiment, one question out of the in total 14 questions will be randomly chosen. In the chosen question, a fair coin will be flipped (heads and tails are equally probable to show). You will receive your earnings corresponding to your decision in the chosen question. For example, if you have chosen a gamble for that question that promises 5\u20ac on heads and 10\u20ac on tails and the the coin flip shows heads, you earn 5\u20ac.<\/span><\/p><\/div><\/div><\/div><\/div><\/div>","DataExportTag":"Q488","QuestionID":"QID488"}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID489","SecondaryAttribute":"In the following task you","TertiaryAttribute":null,"Payload":{"QuestionText":"In the following task you","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"In the following task you","Choices":{"1":{"Display":"can win money or no money"},"2":{"Display":"can win money or lose money"},"3":{"Display":"cannot win any money"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"In the following task you","DataExportTag":"Q489","QuestionID":"QID489"}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID49","SecondaryAttribute":"I tried to avoid conversations about COVID-19","TertiaryAttribute":null,"Payload":{"QuestionText":"I tried to avoid conversations about COVID-19","DefaultChoices":false,"DataExportTag":"Q14","QuestionID":"QID49","QuestionType":"Slider","Selector":"HSLIDER","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","CSSliderMin":0,"CSSliderMax":5,"GridLines":5,"SnapToGrid":false,"NumDecimals":"0","ShowValue":true,"CustomStart":false,"NotApplicable":false,"MobileFirst":true},"QuestionDescription":"I tried to avoid conversations about COVID-19","Choices":{"1":{"Display":"&nbsp;"}},"ChoiceOrder":[1],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":2,"NextAnswerId":7,"Labels":{"1":{"Display":"0=not experienced"},"6":{"Display":"5=very often experienced"}}}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID490","SecondaryAttribute":"Which rounds are selected to determine your earnings?","TertiaryAttribute":null,"Payload":{"QuestionText":"Which rounds are selected to determine your earnings?","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Which rounds are selected to determine your earnings?","Choices":{"1":{"Display":"All 14 rounds are selected"},"2":{"Display":"3 random rounds out of 14  are selected"},"3":{"Display":"1 random round out of 14 is selected"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"Which rounds are selected to determine your earnings?","DataExportTag":"Q490","QuestionID":"QID490"}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID491","SecondaryAttribute":"What is the probability that heads shows for the coin flip?","TertiaryAttribute":null,"Payload":{"QuestionText":"What is the probability that heads shows for the coin flip?","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"What is the probability that heads shows for the coin flip?","Choices":{"1":{"Display":"Heads shows in about 10% of the flips"},"2":{"Display":"50%: Heads and tails are equally probable"},"3":{"Display":"The coin never shows heads"},"4":{"Display":"The coin always shows heads"}},"ChoiceOrder":[1,2,3,4],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionText_Unsafe":"What is the probability that heads shows for the coin flip?","DataExportTag":"Q491","QuestionID":"QID491"}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID492","SecondaryAttribute":"Again:\u00a0In each decision problem, you are encouraged to examine all 5 options \u00a0and\u00a0should choose o","TertiaryAttribute":null,"Payload":{"QuestionText":"Again:&nbsp;<span style=\"font-family: &quot;Times New Roman&quot;; font-size: 12pt;\">In each decision problem, you are encouraged to examine all 5 options &nbsp;and&nbsp;<\/span><span style=\"font-family: &quot;Times New Roman&quot;; font-size: 12pt;\">should choose only one option you like most.&nbsp;<\/span><span style=\"font-family: &quot;Times New Roman&quot;; font-size: 16px;\">Please make careful decisions.<\/span><div><span style=\"font-family: &quot;Times New Roman&quot;; font-size: 16px;\"><br><\/span><\/div><div><span style=\"font-family: &quot;Times New Roman&quot;; font-size: 16px;\">To start the task, click on &gt;&gt;&gt;.<\/span><\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Again:\u00a0In each decision problem, you are encouraged to examine all 5 options \u00a0and\u00a0should choose o...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":11,"NextAnswerId":1,"QuestionText_Unsafe":"Again:&nbsp;<span style=\"font-family: &quot;Times New Roman&quot;; font-size: 12pt;\">In each decision problem, you are encouraged to examine all 5 options &nbsp;and&nbsp;<\/span><span style=\"font-family: &quot;Times New Roman&quot;; font-size: 12pt;\">should choose only one option you like most.&nbsp;<\/span><span style=\"font-family: &quot;Times New Roman&quot;; font-size: 16px;\">Please make careful decisions.<\/span><div><span style=\"font-family: &quot;Times New Roman&quot;; font-size: 16px;\"><br><\/span><\/div><div><span style=\"font-family: &quot;Times New Roman&quot;; font-size: 16px;\">To start the task, click on &gt;&gt;&gt;.<\/span><\/div>","DataExportTag":"Q492","QuestionID":"QID492"}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID493","SecondaryAttribute":"What do the options show?","TertiaryAttribute":null,"Payload":{"QuestionText":"What do the options show?","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"What do the options show?","Choices":{"1":{"Display":"The options show gambles on a coin flip. They indicate a montary reward conditional on which side a coin flip shows."},"2":{"Display":"The options show gambles on a dice roll. They indicate a montary reward conditional on which side a dice roll shows."},"3":{"Display":"The options show two sure rewards each."}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":4,"NextAnswerId":1,"DataVisibility":{"Private":false,"Hidden":false},"QuestionText_Unsafe":"What do the options show?","DataExportTag":"Q493","QuestionID":"QID493"}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID494","SecondaryAttribute":"Remember to make healthy choices.","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\"><span style=\"font-size:22px;\"><strong>Remember to make <u><span style=\"color:#00cc33;\">healthy<\/span><\/u> choices.<\/strong><\/span><\/div>","DefaultChoices":false,"DataExportTag":"Q494","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Remember to make healthy choices.","DisplayLogic":{"0":{"0":{"LogicType":"EmbeddedField","LeftOperand":"reminderCounter","Operator":"LessThan","RightOperand":"2","Type":"Expression","Description":"<span class=\"ConjDesc\">If<\/span>  <span class=\"LeftOpDesc\">reminderCounter<\/span> <span class=\"OpDesc\">Is Less Than<\/span> <span class=