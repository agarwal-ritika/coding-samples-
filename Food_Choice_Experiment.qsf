d"},"2":{"Display":"very good"}},"DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID253","SecondaryAttribute":"Did you lose your job because of COVID19?","TertiaryAttribute":null,"Payload":{"QuestionText":"Did you lose your job because of COVID19?","DataExportTag":"lost job","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","Autoscale":{"YScale":{"Name":"yesNo","Type":"likert","Reverse":false}}},"QuestionDescription":"Did you lose your job because of COVID19?","Choices":{"23":{"Display":"Yes"},"24":{"Display":"No"}},"ChoiceOrder":["23","24"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":25,"NextAnswerId":1,"QuestionID":"QID253","DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID254","SecondaryAttribute":"Are you in your menstrual period (menses will influence the cortisol level that we measure from y...","TertiaryAttribute":null,"Payload":{"QuestionText":"Are you in your&nbsp;menstrual period (menses will influence the cortisol level that we measure from your hair)?","DataExportTag":"menstrual","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","Autoscale":{"YScale":{"Name":"yesNo","Type":"likert","Reverse":false}}},"QuestionDescription":"Are you in your menstrual period (menses will influence the cortisol level that we measure from y...","Choices":{"30":{"Display":"Yes"},"31":{"Display":"No"}},"ChoiceOrder":["30","31"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":32,"NextAnswerId":1,"QuestionID":"QID254","DisplayLogic":{"0":{"0":{"LogicType":"Question","QuestionID":"QID68","QuestionIsInLoop":"no","ChoiceLocator":"q:\/\/QID68\/SelectableChoice\/2","Operator":"Selected","QuestionIDFromLocator":"QID68","LeftOperand":"q:\/\/QID68\/SelectableChoice\/2","Type":"Expression","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">What is your gender<\/span> <span class=\"LeftOpDesc\">Female<\/span> <span class=\"OpDesc\">Is Selected<\/span> "},"Type":"If"},"Type":"BooleanExpression","inPage":false},"DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID255","SecondaryAttribute":"Do you need to take care of dependents (e.g., children, elderly parents or close relatives)","TertiaryAttribute":null,"Payload":{"QuestionText":"Do you need to take care of dependents (e.g., children, elderly parents or close relatives)","DataExportTag":"child","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Do you need to take care of dependents (e.g., children, elderly parents or close relatives)","Choices":{"1":{"Display":"Yes"},"2":{"Display":"No"}},"ChoiceOrder":["1","2"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID255","DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID256","SecondaryAttribute":"Do you have any relatives or close friends who were diagnosed with COVID19? ","TertiaryAttribute":null,"Payload":{"QuestionText":"Do you have any relatives or close friends who were diagnosed with COVID19?&nbsp;","DataExportTag":"Q256","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","Autoscale":{"YScale":{"Name":"yesNo","Type":"likert","Reverse":false}},"LabelPosition":"BELOW"},"QuestionDescription":"Do you have any relatives or close friends who were diagnosed with COVID19? ","Choices":{"23":{"Display":"Yes"},"24":{"Display":"No"}},"ChoiceOrder":["23","24"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":25,"NextAnswerId":1,"QuestionID":"QID256"}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID257","SecondaryAttribute":"In the next task, we are going to present you with different gamble options. Each gamble option i...","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-size:16px;\">In the next task, we are going to present you with different gamble options. Each gamble option is independent of each other.&nbsp;<\/span>\n<div>&nbsp;<\/div>\n\n<div><span style=\"font-size:16px;\"><strong><u>You could choose to reject the gamble option and receive a certain payoff. Or you accept the gamble option, and you have a 50% chance of winning or losing a certain amount of money<\/u>.<\/strong><br>\n<br>\n<strong><u>Note that one of your decisions in this task may be selected to determine the bonus payoff at the end.<\/u><\/strong> If you chose to gamble, the computer will determine whether you win or lose. Accordingly, we will pay you the extra bonus if you win or deduct the loss amount from your participation fee if you lose.<\/span><\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"In the next task, we are going to present you with different gamble options. Each gamble option i...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"Click to write the question text","DataExportTag":"Q257","QuestionID":"QID257","DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID258","SecondaryAttribute":"\u00a0 \u00a0 \u00a0 \u00a0 \u00a0 AcceptReject + Press to the next page","TertiaryAttribute":null,"Payload":{"DefaultChoices":false,"QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"DataVisibility":{"Private":false,"Hidden":false},"QuestionText":"<div id=\"task\" style=\"width: 300px; height: 300px;  \nposition: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%);\njustify-content: center; color: black; background-color: white\">\n<div id=\"win\" style=\"border: 5px; border-style: solid; border-color: black;\nbackground-color: rgb(0, 255, 0); width: 100px; height: 75px; float: left;\ntext-align: center; vertical-align: middle; line-height: 75px; \">&nbsp;<\/div>\n<br \/>\n<br \/>\n&nbsp;\n<div id=\"sure\" style=\"border: 5px; border-style: solid; border-color: black;\nbackground-color: rgb(100, 100, 100); width: 100px; height: 75px; float: right;\ntext-align: center; vertical-align: middle; line-height: 75px; \">&nbsp;<\/div>\n<br \/>\n<br \/>\n&nbsp;\n<div id=\"loss\" style=\"border: 5px; border-style: solid; border-color: black;\nbackground-color: rgb(255, 0, 0); width: 100px; height: 75px; float: left;\ntext-align: center; vertical-align: middle; line-height: 75px; \">&nbsp;<\/div>\n<br \/>\n<br \/>\n<br \/>\n<button id=\"gamble\" style=\"float: left; padding: 1em; width: 100px; text-align: center;\" type=\"button\">Accept<\/button><button id=\"nogamble\" style=\"float: right; padding: 1em; width: 100px; text-align: center;\" type=\"button\">Reject<\/button><\/div>\n\n<h1 id=\"fixation\" style=\"position: fixed; top: 45%; left: 50%; transform: translate(-50%, -50%);\ndisplay: none;\">+<\/h1>\n\n<div id = \"fin_text\" style = \"font-size: 16px; display: none;\">Press >> to the next page<\/div>","QuestionDescription":"\u00a0 \u00a0 \u00a0 \u00a0 \u00a0 AcceptReject + Press to the next page","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n\t\/*Place your JavaScript here to run when the page loads*\/\n\t\n\tqobj = this;\n\t\n\tchange_text = function(id, new_reward) {\n\n\t\tlet reward_text = new_reward + \"\u20ac\";\n\t\t\n\t\tconsole.log(document.getElementById(id));\n\n\t\tdocument.getElementById(id).innerHTML = reward_text\n\t};\n\n\tutilityFcn = function(x,rhop,rhom,lam){\n\t\t\/\/Dependencies: \/\n\t\tif (x >= 0){U = Math.pow(x, rhop)}\n\t\telse {U = -lam * Math.pow(Math.abs(x),rhom)}\n\t\treturn U\n\t};\n\n\tsoftmaxFcn = function(rho, lam, mew, p, x, z, y) {\n\t\tlet rhop = rho; let rhom = rho;\n\t\t\/\/#Dependencies: utilityFcn\n\t\tlet U_gamble = (1-p)*utilityFcn(z, rhop, rhom, lam) + p * utilityFcn(x, rhop, rhom,lam)\n\t\tlet U_sure = utilityFcn(y, rhop, rhom, lam)\n\t\tlet r = Math.pow(1 + Math.exp(-mew * (U_gamble - U_sure)), -1)\n\t\treturn r\n\t};\n\n\tinitialize_dose = function() {\n\t\t\/\/Dependencies: softmaxFcn\n\t\tlet dat = [];\n\n\t\t\/\/All Questions\n\t\tdat[0] = questions\n\n\n\t\tfor (i = 0; i < dat[0].length; i++) {\n\t\t\tdat[0][i][2] = - dat[0][i][2]\n\t\t};\n\n\t\t\/\/Unused Questions\n\t\tdat[1] = dat[0];\n\n\t\t\/\/Rho\n\n\t\tdat[2] = []; dat[3] = [];\n\t\tfor (i = 0; i < rho_parameters.length; i++) {\n\t\t\t\/\/Values\n\t\t\tdat[2][i] = rho_parameters[i][0]\n\t\t\t\/\/Probs\n\t\t\tdat[3][i] = rho_parameters[i][1]\n\t\t};\n\n\t\t\/\/lambda\n\n\t\tdat[4] = []; dat[5] = [];\n\t\tfor (i = 0; i < lambda_parameters.length; i++) {\n\t\t\t\/\/Values\n\t\t\tdat[4][i] = lambda_parameters[i][0]\n\t\t\t\/\/Probs\n\t\t\tdat[5][i] = lambda_parameters[i][1]\n\t\t};\n\n\t\t\/\/mu\n\t\tdat[6] = []; dat[7] = [];\n\n\t\tfor (i = 0; i < mu_parameters.length; i++) {\n\t\t\t\/\/Values\n\t\t\tdat[6][i] = mu_parameters[i][0]\n\t\t\t\/\/Probs\n\t\t\tdat[7][i] = mu_parameters[i][1]\n\t\t};\n\n\t\t\/\/multArray\n\n\t\tdat[8] = [];\n\t\tfor (i = 0; i < dat[2].length; i ++) {\n\t\t\tdat[8][i] = []\n\t\t\tfor (j = 0; j < dat[4].length; j ++) {\n\t\t\t\tdat[8][i][j] = []\n\t\t\t\tfor (k = 0; k < dat[6].length; k ++) {\n\t\t\t\t\tdat[8][i][j][k] = 1\n\t\t\t\t}\n\t\t\t}\n\t\t};\n\n\t\t\/\/tempSoftMaxArray\n\t\tdat[9] = [];\n\n\t\t\/\/SoftMaxArray\n\n\t\tdat[10] = [];\n\t\tfor (i = 0; i < dat[2].length; i ++) {\n\t\t\tdat[10][i] = []\n\t\t\tfor (j = 0; j < dat[4].length; j ++) {\n\t\t\t\tdat[10][i][j] = []\n\t\t\t\tfor (k = 0; k < dat[6].length; k ++) {\n\t\t\t\t\tdat[10][i][j][k] = []\n\t\t\t\t\tfor (questNum = 0; questNum < dat[1].length; questNum ++) {\n\t\t\t\t\t\tdat[10][i][j][k][questNum] = softmaxFcn(dat[2][i], dat[4][j], dat[6][k], 0.5, \n\t\t\t\t\t\t\tdat[1][questNum][2], dat[1][questNum][1], dat[1][questNum][3])\n\t\t\t\t\t\t\/\/if (Number.isNaN(dat[10][i][j][k][questNum])){console.log(i, j, k, questNum)}\n\t\t\t\t\t\t\/\/console.log(dat[10][i][j][k][questNum])\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t};\n\n\t\t\/\/Storing Data per trial\n\n\t\t\/\/Win\n\t\tdat[11] = [];\n\n\t\t\/\/Loss\n\t\tdat[12] = [];\n\n\t\t\/\/Sure\n\t\tdat[13] = [];\n\n\t\t\/\/KL\n\t\tdat[14] = [];\n\n\t\t\/\/Decision\n\t\tdat[15] = [];\n\n\t\t\/\/avgRho\n\t\tdat[16] = [];\n\n\t\t\/\/avgLam\n\t\tdat[17] = [];\n\n\t\t\/\/avgMu\n\t\tdat[18] = [];\n\n\t\t\/\/SErho\n\t\tdat[19] = [];\n\n\t\t\/\/SElam\n\t\tdat[20] = [];\n\n\t\t\/\/SEmu\n\t\tdat[21] = [];\n\n\t\treturn dat\n\t};\n\n\tKLCalculator_rho_lam_mu = function(dat, questionNum) {\n\n\n\t\t\/\/LikeliHoodYesArray \n\t\tdat[22] = [];\n\t\t\/\/LikeliHoodNoArray \n\t\tdat[23] = [];\n\n\t\tlet sumYesDenom = 0;\n\t\tlet sumNoDenom = 0;\n\n\t\tfor (i = 0; i < dat[2].length; i ++) {\n\t\t\tdat[22][i] = []\n\t\t\tdat[23][i] = []\n\t\t\tfor (j = 0; j < dat[4].length; j ++) {\n\t\t\t\tdat[22][i][j] = []\n\t\t\t\tdat[23][i][j] = []\n\t\t\t\tfor (k = 0; k < dat[6].length; k ++) {\n\t\t\t\t\tdat[22][i][j][k] = dat[8][i][j][k] * dat[10][i][j][k][questionNum]\n\t\t\t\t\tif (dat[22][i][j][k] == 0) {dat[22][i][j][k] += Math.pow(10, -300)}\n\n\t\t\t\t\tdat[23][i][j][k] = dat[8][i][j][k] * (1 - dat[10][i][j][k][questionNum])\n\t\t\t\t\tif (dat[23][i][j][k] == 0) {dat[23][i][j][k] += Math.pow(10, -300)}\n\n\t\t\t\t\t\/\/console.log(dat[22][i][j][k])\n\n\t\t\t\t\tsumYesDenom += dat[3][i] * dat[5][j] * dat[7][k] * dat[22][i][j][k]\n\t\t\t\t\tsumNoDenom += dat[3][i] * dat[5][j] * dat[7][k] * dat[23][i][j][k]  \n\t\t\t\t}\n\t\t\t}\n\t\t};\n\n\t\t\/\/console.log(dat[22])\n\n\t\tlet KLnum = 0\n\n\t\t\/\/console.log(sumYesDenom)\n\n\n\t\tfor (i = 0; i < dat[2].length; i ++) {\n\t\t\tfor (j = 0; j < dat[4].length; j ++) {\n\t\t\t\tfor (k = 0; k < dat[6].length; k ++) {\n\n\t\t\t\t\tlet sumYesDenomThis = sumYesDenom - dat[22][i][j][k] * dat[3][i] * dat[5][j] * dat[7][k]\n\t\t\t\t\tlet sumNoDenomThis = sumNoDenom - dat[23][i][j][k] * dat[3][i] * dat[5][j] * dat[7][k]\n\n\t\t\t\t\tlet yesMod = dat[22][i][j][k] * Math.log(((1 - (dat[3][i] * dat[5][j] * dat[7][k])) * dat[22][i][j][k]) \/ sumYesDenomThis)\n\t\t\t\t\tlet noMod = dat[23][i][j][k] * Math.log(((1 - (dat[3][i] * dat[5][j] * dat[7][k])) * dat[23][i][j][k]) \/ sumNoDenomThis)\n\n\t\t\t\t\tKLnum += (yesMod + noMod) * dat[3][i] * dat[5][j] * dat[7][k]\n\t\t\t\t}\n\t\t\t}\n\t\t};\n\n\t\treturn KLnum\n\t};\n\n\tgetQuestion = function(dat, trial) {\n\t\t\/\/Dependencies: KLCalculator_rho_lam_mum\n\n\t\tlet KL = [];\n\t\tfor (questNum = 0; questNum < dat[1].length; questNum ++) {\n\t\t\tKL[questNum] = KLCalculator_rho_lam_mu(dat, questNum)\n\t\t}\n\n\t\t\/\/console.log(KL)\n\n\t\tlet maxKL = Math.max(...KL);\n\t\tlet bestQ = KL.indexOf(Math.max(...KL));\n\n\t\t\/\/console.log(maxKL);\n\t\tconsole.log(bestQ)\n\n\n\t\tdat[11][trial] = dat[1][bestQ][1]\n\t\tconsole.log(dat[11][trial])\n\t\tdat[12][trial] = dat[1][bestQ][2]\n\t\tdat[13][trial] = dat[1][bestQ][3]\n\t\tdat[14][trial] = maxKL\n\n\n\t\tfor (i = 0; i < dat[2].length; i ++) {\n\t\t\tdat[9][i] = []\n\t\t\tfor (j = 0; j < dat[4].length; j ++) {\n\t\t\t\tdat[9][i][j] = []\n\t\t\t\tfor (k = 0; k < dat[6].length; k ++) {\n\t\t\t\t\tdat[9][i][j][k] = dat[10][i][j][k][bestQ]\n\t\t\t\t\tdat[10][i][j][k].splice(bestQ, 1)\n\t\t\t\t}\n\t\t\t}\n\t\t};\n\n\t\tdat[1].splice(bestQ, 1)\n\n\t\treturn dat\n\t};\n\n\tparams_ProbUpdater = function(dat) {\n\n\t\tlet denom = 0;\n\n\n\t\tfor (i = 0; i < dat[2].length; i ++) {\n\t\t\tfor (j = 0; j < dat[4].length; j ++) {\n\t\t\t\tfor (k = 0; k < dat[6].length; k ++) {\n\t\t\t\t\tdenom += dat[9][i][j][k] * dat[3][i] * dat[5][j] * dat[7][k]\n\t\t\t\t}\n\t\t\t}\n\t\t};\n\n\t\tlet totalProb = [];\n\n\t\tfor (i = 0; i < dat[2].length; i ++) {\n\t\t\ttotalProb[i] = []\n\t\t\tfor (j = 0; j < dat[4].length; j ++) {\n\t\t\t\ttotalProb[i][j] = []\n\t\t\t\tfor (k = 0; k < dat[6].length; k ++) {\n\t\t\t\t\ttotalProb[i][j][k] = dat[9][i][j][k] * dat[3][i] * dat[5][j] * dat[7][k] \/ denom\n\t\t\t\t}\n\t\t\t}\n\t\t};\n\t\treturn totalProb\n\t};\n\n\tupdate_Params = function(dat, trial) {\n\t\tuser_answer = dat[15][trial-1]\n\n\n\n\t\tfor (i = 0; i < dat[2].length; i ++) {\n\t\t\tfor (j = 0; j < dat[4].length; j ++) {\n\t\t\t\tfor (k = 0; k < dat[6].length; k ++) {\n\t\t\t\t\tif (user_answer == 1) {\n\t\t\t\t\t\tdat[9][i][j][k] = 1 - dat[9][i][j][k]}\n\t\t\t\t\tdat[8][i][j][k] = dat[8][i][j][k] * dat[9][i][j][k]\n\t\t\t\t}\n\t\t\t}\n\t\t};\n\n\t\ttempProbMatrix = params_ProbUpdater(dat)\n\n\n\t\tfor (i = 0; i < dat[2].length; i ++) {dat[3][i] = 0}\n\t\tfor (j = 0; j < dat[4].length; j ++) {dat[5][j] = 0}\n\t\tfor (k = 0; k < dat[6].length; k ++) {dat[7][k] = 0}\n\t\t\n\t\tfor (i = 0; i < dat[2].length; i ++) {\n\t\t\tfor (j = 0; j < dat[4].length; j ++) {\n\t\t\t\tfor (k = 0; k < dat[6].length; k ++) {\n\t\t\t\t\tdat[3][i] += tempProbMatrix[i][j][k]\n\t\t\t\t\tdat[5][j] += tempProbMatrix[i][j][k]\n\t\t\t\t\tdat[7][k] += tempProbMatrix[i][j][k]\n\t\t\t\t\tdat[8][i][j][k] = dat[8][i][j][k] * dat[9][i][j][k]\n\t\t\t\t}  \n\t\t\t} \n\t\t};\n\n\t\tdat[16][trial] = 0;\n\t\tdat[17][trial] = 0;\n\t\tdat[18][trial] = 0;\n\n\t\tfor (i = 0; i < dat[2].length; i ++) {dat[16][trial] += dat[2][i] * dat[3][i]}\n\t\tfor (j = 0; j < dat[4].length; j ++) {dat[17][trial] += dat[4][j] * dat[5][j]}\n\t\tfor (k = 0; k < dat[6].length; k ++) {dat[18][trial] += dat[6][k] * dat[7][k]}\