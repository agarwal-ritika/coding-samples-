,"ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID70"}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID71","SecondaryAttribute":"Have you been tested positive for COVID-19?","TertiaryAttribute":null,"Payload":{"QuestionText":"Have you been tested positive for COVID-19?","DataExportTag":"test positive","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","Autoscale":{"YScale":{"Name":"yesNo","Type":"likert","Reverse":false}}},"QuestionDescription":"Have you been tested positive for COVID-19?","Choices":{"1":{"Display":"Yes"},"2":{"Display":"No"}},"ChoiceOrder":[1,2],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":3,"NextAnswerId":1,"QuestionID":"QID71","DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID72","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","DataExportTag":"Q72","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click to write the question text","Choices":{"1":{"Display":"Click to write Choice 1"},"2":{"Display":"Click to write Choice 2"},"3":{"Display":"Click to write Choice 3"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID72"}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID73","SecondaryAttribute":"Have you ever experienced the symptoms of COVID-19 (e.g., fever, tiredness or dry cough)?","TertiaryAttribute":null,"Payload":{"QuestionText":"Have you ever experienced the symptoms of COVID-19 (e.g., fever, tiredness or dry cough)?","DataExportTag":"symptoms","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","Autoscale":{"YScale":{"Name":"yesNo","Type":"likert","Reverse":false}}},"QuestionDescription":"Have you ever experienced the symptoms of COVID-19 (e.g., fever, tiredness or dry cough)?","Choices":{"1":{"Display":"Yes"},"2":{"Display":"No"}},"ChoiceOrder":[1,2],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":3,"NextAnswerId":1,"QuestionID":"QID73","GradingData":[],"DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID74","SecondaryAttribute":"Please note these numbers in the text box below and then describe briefly how you felt and what y...","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-size:16px;\">Please note these numbers in the text box below and then describe briefly how you felt and what your thoughts while you were infected with the coronavirus?&nbsp;<\/span>\n<div>&nbsp;<\/div>\n\n<div><span style=\"font-size:16px;\">According to the World Health Organization (WHO) the coronavirus (COVID-19) is a highly contagious acute pneumonia of unknown cause with acute outbreaks around the world at this time. There is currently no vaccine or specific antiviral treatment. According to the WHO, globally, more than 1.5 million cases of COVID-19 have been reported which have led to over 87,000 deaths. In the United States, CDC has reported 420,000 confirmed cases with over 14,000 deaths.&nbsp;<strong>If you get infected with COVID-19, there is 20% chance that you would develop into severe or critical illness. The death rate of COVID-19 is 2.4%, which is 24 times higher than the death rate of influenza at 0.1%.<\/strong>&nbsp;<\/span><\/div>\n\n<div>&nbsp;<\/div>","DefaultChoices":false,"DataExportTag":"s1 high salience","QuestionID":"QID74","QuestionType":"TE","Selector":"ESTB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please note these numbers in the text box below and then describe briefly how you felt and what y...","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"MinChar","MinChars":"5"}},"GradingData":[],"Language":[],"NextChoiceId":1,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"}}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID75","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","DataExportTag":"scenario 1","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click to write the question text","Choices":{"1":{"Display":"Click to write Choice 1"},"2":{"Display":"Click to write Choice 2"},"3":{"Display":"Click to write Choice 3"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID75"}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID76","SecondaryAttribute":"Please note these numbers in the text box below and then describe briefly how you are feeling and...","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-size:16px;\">Please note these numbers in the text box below and then describe briefly how you are feeling and what your thoughts while experiencing symptoms of the coronavirus?&nbsp;<\/span>\n<div>&nbsp;<\/div>\n\n<div><span style=\"font-size:16px;\">According to the World Health Organization (WHO) the coronavirus (COVID-19) is a highly contagious acute pneumonia of unknown cause with acute outbreaks around the world at this time. There is currently no vaccine or specific antiviral treatment. According to the WHO, globally, more than 1.5 million cases of COVID-19 have been reported which have led to over 87,000 deaths. In the United States, CDC has reported 420,000 confirmed cases with over 14,000 deaths.&nbsp;<strong>If you get infected with COVID-19, there is 20% chance that you would develop into severe or critical illness. The death rate of COVID-19 is 2.4%, which is 24 times higher than the death rate of influenza at 0.1%.&nbsp;<\/strong><\/span><\/div>","DefaultChoices":false,"DataExportTag":"s2 high salience","QuestionID":"QID76","QuestionType":"TE","Selector":"ESTB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please note these numbers in the text box below and then describe briefly how you are feeling and...","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"MinChar","MinChars":"5"}},"GradingData":[],"Language":[],"NextChoiceId":1,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"}}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID77","SecondaryAttribute":"Please note these numbers in the text box below and then describe briefly how you are feeling and...","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-size: 16px;\">Please note these numbers in the text box below and then describe briefly how you are feeling and what your thoughts while experiencing symptoms of the coronavirus?&nbsp;<\/span>\n<div>&nbsp;<\/div>\n\n<div><span style=\"font-size: 16px;\">According to the World Health Organization (WHO) the coronavirus (COVID-19) is contagious pneumonia of unknown cause with acute outbreaks around the world at this time. There is currently no vaccine or specific antiviral treatment. According to WHO, globally, more than 1.5 million cases of COVID-19 have been reported and 320,000 people who suffered from the virus have recovered from the illness. In the United States, CDC has reported over 420,000 confirmed cases and more than 23,000 people have recovered so far.&nbsp;<\/span><strong><span style=\"font-size: 16px;\">If you get infected with COVID-19, there is 80% chance that you would have mild illness and make a full recovery within a few weeks. The survival rate of COVID-19 is 97.6%<\/span><span style=\"font-size: 16px;\">.<\/span><\/strong><\/div>","DefaultChoices":false,"DataExportTag":"S2 low salience","QuestionID":"QID77","QuestionType":"TE","Selector":"ESTB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please note these numbers in the text box below and then describe briefly how you are feeling and...","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"MinChar","MinChars":"5"}},"GradingData":[],"Language":[],"NextChoiceId":1,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"}}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID78","SecondaryAttribute":"Please note these numbers in the text box below and then describe briefly how you felt and what y...","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-size: 16px;\">Please note these numbers in the text box below and then describe briefly how you felt and what your thoughts while you were infected with the coronavirus?&nbsp;<\/span>\n<div>&nbsp;<\/div>\n\n<div><span style=\"font-size: 16px;\">According to the World Health Organization (WHO) the coronavirus (COVID-19) is contagious pneumonia of unknown cause with acute outbreaks around the world at this time. There is currently no vaccine or specific antiviral treatment. According to WHO, globally, more than 1.5 million cases of COVID-19 have been reported and 320,000 people who suffered from the virus have recovered from the illness. In the United States, CDC has reported over 420,000 confirmed cases and more than 23,000 people have recovered so far.<strong>&nbsp;<\/strong><\/span><strong><span style=\"font-size: 16px;\">If you get infected with COVID-19, there is 80% chance that you would have mild illness and make a full recovery within a few weeks. The survival rate of COVID-19 is 97.6%<\/span><\/strong>\n\n<div>&nbsp;<\/div>\n<\/div>","DefaultChoices":false,"DataExportTag":"s1 low salience","QuestionID":"QID78","QuestionType":"TE","Selector":"ESTB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please note these numbers in the text box below and then describe briefly how you felt and what y...","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"MinChar","MinChars":"5"}},"GradingData":[],"Language":[],"NextChoiceId":1,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID79","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","DataExportTag":"Q79","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click to write the question text","Choices":{"1":{"Display":"Click to write Choice 1"},"2":{"Display":"Click to write Choice 2"},"3":{"Display":"Click to write Choice 3"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID79"}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID8","SecondaryAttribute":"Excited","TertiaryAttribute":null,"Payload":{"QuestionText":"Excited","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Excited","Choices":{"1":{"Display":"Very Slightly or Not at All"},"2":{"Display":"A Little "},"3":{"Display":"Moderately "},"4":{"Display":"Quite a Bit "},"5":{"Display":"Extremely"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"GradingData":[{"ChoiceID":1,"Grades":{"SC_9uAHPqAYaLyL8ix":1},"index":0},{"ChoiceID":2,"Grades":{"SC_9uAHPqAYaLyL8ix":2},"index":1},{"ChoiceID":3,"Grades":{"SC_9uAHPqAYaLyL8ix":3},"index":2},{"ChoiceID":4,"Grades":{"SC_9uAHPqAYaLyL8ix":4},"index":3},{"ChoiceID":5,"Grades":{"SC_9uAHPqAYaLyL8ix":5},"index":4}],"QuestionText_Unsafe":"Excited","DataExportTag":"Q3","QuestionID":"QID8","DataVisibility":{"Private":false,"Hidden":false},"NextChoiceId":6,"NextAnswerId":1}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID80","SecondaryAttribute":"Please read carefully the information below: According to the World Health Organization (WHO) the...","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-size:16px;\">Please read carefully the information below:<br>\n<br>\nAccording to the World Health Organization (WHO) the coronavirus (COVID-19) is a highly contagious acute pneumonia of unknown cause with acute outbreaks around the world at this time. There is currently no vaccine or specific antiviral treatment.&nbsp;<\/span><div><span style=\"font-size:16px;\"><br><\/span><\/div><div><span style=\"font-size:16px;\">According to the WHO, globally, more than 8 million cases of COVID-19 have been reported which have led to over 450,000 deaths. In France, WHO has reported 158,000 confirmed cases with over 30,000 deaths.<strong>&nbsp;If you get infected with COVID-19, there is 20% chance that you would develop into severe or critical illness. The death rate of COVID-19 is 18%, which is 180 times higher than the death rate of influenza at 0.1%.&nbsp;<\/strong><br>\n&nbsp;<\/span>\n<div>&nbsp;<\/div><\/div>","DefaultChoices":false,"DataExportTag":"s1 high salience","QuestionID":"QID80","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please read carefully the information below: According to the World Health Organization (WHO) the...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID81","SecondaryAttribute":"Please read carefully the information below: \u00a0 According to the World Health Organization (WHO) t..","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><span style=\"font-size:16px;\">Please read carefully the information below:<br><\/span><\/p>\n\n<p>&nbsp;<\/p>\n\n<p><span style=\"font-size:16px;\">According to the World Health Organization (WHO) the coronavirus (COVID-19) is contagious pneumonia of unknown cause with acute outbreaks around the world at this time. There is currently no vaccine or specific antiviral treatment. According to WHO, globally, more than 8 million cases of COVID-19 have been reported and 4 million people who suffered from the virus have recovered from the illness. In France, WHO has reported over 158,000 confirmed cases and more than 73,000 people have recovered so far.&nbsp;<strong>If you get infected with COVID-19, there is 80% chance that you would have mild illness and make a full recovery within a few weeks. The survival rate of COVID-19 is 81%.<\/strong><\/span><\/p>\n\n<div>\n<div>&nbsp;<\/div>\n<\/div>","DefaultChoices":false,"DataExportTag":"s1 low salience","QuestionID":"QID81","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please read carefully the information below: \u00a0 According to the World Health Organization (WHO) t...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID82","SecondaryAttribute":"Please read carefully the information below:According to the World Health Organization (WHO) the...","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-size:16px;\">Please read carefully the information below:<\/span><br>\n<br>\n<span style=\"font-size: 16px;\">According to the World Health Organization (WHO) the coronavirus (COVID-19) is a highly contagious acute pneumonia of unknown cause with acute outbreaks around the world at this time. There is currently no vaccine or specific antiviral treatment.&nbsp;<\/span><div><span style=\"font-size: 16px;\"><br><\/span><\/div><div><span style=\"font-size: 16px;\">According to the WHO, globally, more than 8 million cases of COVID-19 have been reported which have led to over 450,000 deaths. In France, WHO has reported 158,000 confirmed cases with over 30,000 deaths.<\/span><span style=\"font-size: 16px;\">&nbsp;<strong>If you get infected with COVID-19, there is 20% chance that you would develop into severe or critical illness. The death rate of COVID-19 is 18%, which is 180 times higher than the death rate of influenza at 0.1%.&nbsp;<\/strong><\/span>\n<div>&nbsp;<\/div><\/div>","DefaultChoices":false,"DataExportTag":"s2 high salience","QuestionID":"QID82","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please read carefully the information below:According to the World Health Organization (WHO) the...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID83","SecondaryAttribute":"Please read carefully the information below:According to the World Health Organization (WHO) the...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><span style=\"font-size:16px;\">Please read carefully the information below:<\/span><br>\n<br>\n<span style=\"font-family: Arial, Helvetica, sans-serif;\"><span style=\"font-size: 16px;\"><span lang=\"EN-US\">According to the World Health Organization (WHO) the coronavirus (COVID-19) is contagious pneumonia of unknown cause with acute outbreaks around the world at this time. There is currently no vaccine or specific antiviral treatment. According to WHO, globally, more than 8 million cases of COVID-19 have been reported and 4 million people who suffered from the virus have recovered from the illness. In France, WHO has reported over 158,000 confirmed cases and more than 73,000 people have recovered so far.&nbsp;<strong>If you get infected with COVID-19, there is 80% chance that you would have mild illness and make a full recovery within a few weeks. The survival rate of COVID-19 is 81%.<\/strong><\/span><\/span><\/span><\/p>\n\n<div>&nbsp;<\/div>","DefaultChoices":false,"DataExportTag":"s2 low salience","QuestionID":"QID83","QuestionType":"TE","Selector":"ESTB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please read carefully the information below:According to the World Health Organization (WHO) the...","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"MinChar","MinChars":"10"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID84","SecondaryAttribute":"Please read carefully the information below:\u00a0\u00a0 According to the World Health Organization (WHO) t.","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-size: 16px;\">Please read carefully the information below:<\/span><br><span style=\"font-size:16px;\">&nbsp;&nbsp;<br>\nAccording to the World Health Organization (WHO) the coronavirus (COVID-19) is a highly contagious acute pneumonia of unknown cause with acute outbreaks around the world at this time. There is currently no vaccine or specific antiviral treatment.&nbsp;<\/span><div><span style=\"font-size:16px;\"><br><\/span><\/div><div><span style=\"font-size:16px;\">According to the WHO, globally, more than 8 million cases of COVID-19 have been reported which have led to over 450,000 deaths. In France, WHO has reported 158,000 confirmed cases with over 30,000 deaths.&nbsp;<strong>If you get infected with COVID-19, there is 20% chance that you would develop into severe or critical illness. The death rate of COVID-19 is 18%, which is 180 times higher than the death rate of influenza at 0.1%.&nbsp;<\/strong><\/span>\n<div>&nbsp;<\/div><\/div>","DefaultChoices":false,"DataExportTag":"s3 high salience","QuestionID":"QID84","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please read carefully the information below:\u00a0\u00a0 According to the World Health Organization (WHO) t...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":2,"NextAnswerId":1}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID85","SecondaryAttribute":"Please read carefully the information below: \u00a0 According to the World Health Organization (WHO) t..","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><span style=\"font-size: 16px;\">Please read carefully the information below:<\/span><br><\/p>\n\n<p>&nbsp;<\/p>\n\n<p><span style=\"font-family:Arial,Helvetica,sans-serif;\"><span style=\"font-size:16px;\"><span lang=\"EN-US\">According to the World Health Organization (WHO) the coronavirus (COVID-19) is contagious pneumonia of unknown cause with acute outbreaks around the world at this time. There is currently no vaccine or specific antiviral treatment. According to WHO, globally, more than 8 million cases of COVID-19 have been reported and 4 million people who suffered from the virus have recovered from the illness. In France, WHO has reported over 158,000 confirmed cases and more than 73,000 people have recovered so far.&nbsp;<strong>If you get infected with COVID-19, there is 80% chance that you would have mild illness and make a full recovery within a few weeks. The survival rate of COVID-19 is 81%.<\/strong><\/span><\/span><\/span><\/p>\n\n<p>&nbsp;<\/p>","DefaultChoices":false,"DataExportTag":"s3 low salience","QuestionID":"QID85","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please read carefully the information below: \u00a0 According to the World Health Organization (WHO) t...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID86","SecondaryAttribute":"Have you been tested positive for COVID-19?","TertiaryAttribute":null,"Payload":{"QuestionText":"Have you been tested positive for COVID-19?","DataExportTag":"positive COVID19","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","Autoscale":{"YScale":{"Name":"yesNo","Type":"likert","Reverse":false}}},"QuestionDescription":"Have you been tested positive for COVID-19?","Choices":{"1":{"Display":"Yes"},"2":{"Display":"No"}},"ChoiceOrder":[1,2],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":3,"NextAnswerId":1,"QuestionID":"QID86"}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID87","SecondaryAttribute":"Have you ever experienced the symptoms of COVID-19 (e.g., fever, tiredness or dry cough)?","TertiaryAttribute":null,"Payload":{"QuestionText":"Have you ever experienced the symptoms of COVID-19 (e.g., fever, tiredness or dry cough)?","DataExportTag":"symptom","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","Autoscale":{"YScale":{"Name":"yesNo","Type":"likert","Reverse":false}}},"QuestionDescription":"Have you ever experienced the symptoms of COVID-19 (e.g., fever, tiredness or dry cough)?","Choices":{"1":{"Display":"Yes"},"2":{"Display":"No"}},"ChoiceOrder":[1,2],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":3,"NextAnswerId":1,"QuestionID":"QID87","GradingData":[],"DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID88","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","DataExportTag":"Q88","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click to write the question text","Choices":{"1":{"Display":"Click to write Choice 1"},"2":{"Display":"Click to write Choice 2"},"3":{"Display":"Click to write Choice 3"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID88"}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID89","SecondaryAttribute":"Now, we will ask you some questions about your emotions and thoughts. Please press \" \" to continue. ","TertiaryAttribute":null,"Payload":{"QuestionText":"Now, we will ask you some questions about your emotions and thoughts. Please press \"&gt;&gt;\" to continue. &nbsp;","DefaultChoices":false,"DataExportTag":"To begin","QuestionID":"QID89","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Now, we will ask you some questions about your emotions and thoughts. Please press \" \" to continue. ","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":1,"NextAnswerId":1}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID9","SecondaryAttribute":"Upset","TertiaryAttribute":null,"Payload":{"QuestionText":"Upset","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Upset","Choices":{"1":{"Display":"Very Slightly or Not at All"},"2":{"Display":"A Little "},"3":{"Display":"Moderately "},"4":{"Display":"Quite a Bit "},"5":{"Display":"Extremely"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"GradingData":[{"ChoiceID":1,"Grades":{"SC_9uAHPqAYaLyL8ix":1},"index":0},{"ChoiceID":2,"Grades":{"SC_9uAHPqAYaLyL8ix":2},"index":1},{"ChoiceID":3,"Grades":{"SC_9uAHPqAYaLyL8ix":3},"index":2},{"ChoiceID":4,"Grades":{"SC_9uAHPqAYaLyL8ix":4},"index":3},{"ChoiceID":5,"Grades":{"SC_9uAHPqAYaLyL8ix":5},"index":4}],"QuestionText_Unsafe":"Upset","DataExportTag":"Q4","QuestionID":"QID9","DataVisibility":{"Private":false,"Hidden":false},"NextChoiceId":6,"NextAnswerId":1}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID90","SecondaryAttribute":"Now, we will ask you about some social demographic questions.","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-size:16px;\">Now, we will ask you about some social demographic questions.<\/span>","DefaultChoices":false,"DataExportTag":"instruction","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Now, we will ask you about some social demographic questions.","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":1,"NextAnswerId":1,"QuestionID":"QID90","DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID91","SecondaryAttribute":"What is your employment state right now?","TertiaryAttribute":null,"Payload":{"QuestionText":"What is your employment state right now?","DataExportTag":"employment","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"What is your employment state right now?","Choices":{"9":{"Display":"Employed full time"},"10":{"Display":"Employed part time"},"11":{"Display":"Self-employed"},"14":{"Display":"Unemployed"},"15":{"Display":"Retired"},"16":{"Display":"Student"},"17":{"Display":"Others"}},"ChoiceOrder":["9","10","11","14","15","16","17"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":18,"NextAnswerId":1,"QuestionID":"QID91","DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID92","SecondaryAttribute":"We would like to debrief you about the tasks and questionnaires that you performed. \u00a0 The aim of...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div><div>We would like to debrief you about the tasks and questionnaires that you performed. &nbsp;<\/div><div><br><\/div><div>The aim of this study was to test how the current COVID-19 pandemic affects your feelings of stress and anxiety. Previous studies have shown that crises and traumatic environmental events negatively affect our emotional balance, especially when news speaks heavily about death risks. Stress and fear also have a negative impact on our ability to make everyday decisions. In this study, we specifically tested how you evaluate different daily objects and your budgeting preferences. There was no deception in the tasks. &nbsp; &nbsp;<\/div><div><br><\/div><div>You can check out these relevant studies to learn more information:<\/div><div><br><\/div><div>Porcelli, A., Delgado, M. (2016). Stress and decision making: effects on valuation, learning, and risk-taking Current Opinion in Behavioral Sciences 14, 33 - 39.<\/div><div><br><\/div><div>Griskevicius, V., Tybur, J. M., Delton, A. W., &amp; Robertson, T. E. (2011). The influence of mortality and socioeconomic status on risk and delayed rewards: a life history theory approach. Journal of Personality and Social Psychology, 100(6), 1015.<\/div><div><br><\/div><div>Ferraro, R., Shiv, B., Bettman, J. (2005). Let Us Eat and Drink, for Tomorrow We Shall Die: Effects of Mortality Salience and Self\u2010Esteem on Self\u2010Regulation in Consumer Choice, Journal of Consumer Research 32 (1), 65-75.<\/div><div>&nbsp;<\/div><div>If you have any questions about this study, please contact Dr. Hilke Plassmann (hilke.plassmann@insead.edu).<\/div><\/div><div><br><\/div><div>&nbsp;<\/div>","DefaultChoices":false,"DataExportTag":"debriefing","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"We would like to debrief you about the tasks and questionnaires that you performed. \u00a0 The aim of...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":11,"NextAnswerId":1,"QuestionID":"QID92","DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID93","SecondaryAttribute":"To what extent, do you believe the numbers that are published by the authorities?","TertiaryAttribute":null,"Payload":{"QuestionText":"To what extent, do you believe the numbers that are published by the authorities?","DefaultChoices":false,"DataExportTag":"confidence","QuestionType":"Slider","Selector":"HSLIDER","Configuration":{"QuestionDescriptionOption":"UseText","CSSliderMin":1,"CSSliderMax":9,"GridLines":8,"SnapToGrid":false,"NumDecimals":"0","ShowValue":true,"CustomStart":false,"NotApplicable":false,"MobileFirst":true},"QuestionDescription":"To what extent, do you believe the numbers that are published by the authorities?","Choices":{"1":{"Display":"extent of belief"}},"ChoiceOrder":["1"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":3,"Labels":{"1":{"Display":"Not at all"},"2":{"Display":"Very much"}},"QuestionID":"QID93","DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID94","SecondaryAttribute":"Please enter your Mturk ID in the space below.","TertiaryAttribute":null,"Payload":{"QuestionText":"Please enter your Mturk ID in the space below.","DefaultChoices":false,"QuestionType":"TE","Selector":"SL","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please enter your Mturk ID in the space below.","Choices":{"1":{"Display":"Click to write Choice 1"},"2":{"Display":"Click to write Choice 2"},"3":{"Display":"Click to write Choice 3"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionText_Unsafe":"Please enter your Mturk ID in the space below.","DataExportTag":"Q94","QuestionID":"QID94"}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID95","SecondaryAttribute":"The next task consists of two unrelated components.\u00a0 \u00a0 In the first part, we are interested in yo.","TertiaryAttribute":null,"Payload":{"QuestionText":"<div><span style=\"font-size: 16px;\">The next task consists of <\/span><strong style=\"font-size: 16px;\">two unrelated components<\/strong><span style=\"font-size: 16px;\">.&nbsp;<\/span><\/div>\n\n<div>&nbsp;<\/div>\n<span style=\"font-size: 16px;\">In the first part, we are interested in your&nbsp;cognitive abilities. We will ask you three different quiz questions.<\/span>&nbsp;<span style=\"font-size: 16px;\">If you answer <strong>at least two of them<\/strong> correctly, you qualify to participate in a lottery. In this lottery,&nbsp;you have a 50% chance of winning <strong>an extra<\/strong> <\/span><span style=\"font-size:16px;\"><strong>2\u20ac<\/strong><\/span><span style=\"font-size: 16px;\"> or a 50% chance of winning nothing.<\/span>&nbsp;\n\n<div>&nbsp;<\/div>\n\n<div><span style=\"font-size: 16px;\">Note that the lottery results <strong>may&nbsp;be selected for real as the bonus payoff<\/strong>&nbsp;at the end of the experiment<\/span>\n\n<div>&nbsp;<\/div>\n\n<div><span style=\"font-size:16px;\">In the second part, we are interested in&nbsp;your <strong>preferences <\/strong>for different pictures showing animals, objects and scary or unpleasant situations. It is very important that you <strong>consider carefully those pictures<\/strong> when answering our questions.<\/span><\/div>\n<\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"The next task consists of two unrelated components.\u00a0 \u00a0 In the first part, we are interested in yo...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"QuestionText_Unsafe":"<span style=\"font-size:16px;\">In the next <strong>10<\/strong><strong><strong> min<\/strong><\/strong> you will participate in <strong>several unrelated studies<\/strong>. Please ensure the&nbsp;<strong>javascript function<\/strong> of your browser is <strong>enable<\/strong> so that the following tasks can run properly!<br>\n<br>\nThe goal of these studies is to understand your <strong>cognitive abilities<\/strong> and your <strong>preferences <\/strong>for different pictures showing animals, objects and scary or unpleasant situations. It is very important that you <strong>consider carefully those pictures<\/strong> when answering our questions. Your data will be kept completely confidential and no personally identifiable information will be collected.<\/span>\n<div>&nbsp;\n<p><span style=\"font-size:16px;\">You will earn US$1.00 in exchange for your participation, plus a potential bonus&nbsp;payment of US$1.00 based on your&nbsp;performance.&nbsp;At the end of the survey, you will receive a code which you will need to paste in MTurk to receive your compensation.<\/span><\/p>\n\n<p>&nbsp;<\/p>\n\n<p><span style=\"font-size:16px;\">You can give your consent to participate by clicking on the \"&gt;&gt;\" button below.<\/span><\/p>\n<\/div>","DataExportTag":"instruct","QuestionID":"QID95","DataVisibility":{"Private":false,"Hidden":false},"NextChoiceId":1,"NextAnswerId":1}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID96","SecondaryAttribute":"\u00a0\n What do you think was the\n goal of this study?","TertiaryAttribute":null,"Payload":{"QuestionText":"&nbsp;\n<p><span style=\"font-size:16px;\">What do you think was the <strong>goal <\/strong>of this study?<\/span><\/p>","DefaultChoices":false,"QuestionType":"TE","Selector":"ESTB","Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline"},"QuestionDescription":"\u00a0\n What do you think was the\n goal of this study?","Choices":{"1":{"Display":"Would a weight fluctuation of 2.5 kilos affect the way you live your life?"},"2":{"Display":"Do you eat sensibly in front of others and splurge alone?"},"3":{"Display":"Do you give too much time and thought to food?"},"4":{"Display":"Do you have feelings of guilt after overeating?"},"5":{"Display":"How conscious are you of what you are eating?"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionText_Unsafe":"&nbsp;\n<p><span style=\"font-size:16px;\">What do you think was the <strong>goal <\/strong>of this study?<\/span><\/p>","DataExportTag":"Q96","QuestionID":"QID96"}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID97","SecondaryAttribute":"How boring was the task about memorizing the\ndifferent two-digits numbers?","TertiaryAttribute":null,"Payload":{"QuestionText":"<font size=\"3\">How boring was the task about memorizing the different two-digits numbers?<br><\/font>","DefaultChoices":false,"QuestionType":"Slider","Selector":"HSLIDER","Configuration":{"QuestionDescriptionOption":"UseText","CSSliderMin":-4,"CSSliderMax":4,"GridLines":8,"SnapToGrid":false,"NumDecimals":"0","ShowValue":false,"CustomStart":true,"SliderStartPositions":{"1":0.490405117270790003036751159015693701803684234619140625},"NotApplicable":false,"CenterLabels":true,"MobileFirst":true},"QuestionDescription":"How boring was the task about memorizing the\ndifferent two-digits numbers?","Choices":{"2":{"Display":"boredom"}},"ChoiceOrder":["2"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"Labels":{"1":{"Display":"very boring"},"3":{"Display":"very interesting"}},"QuestionText_Unsafe":"<font size=\"3\">How boring was the task about memorizing the different two-digits numbers?<br><\/font>","DataExportTag":"Q97","QuestionID":"QID97"}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID98","SecondaryAttribute":"What is your gender?","TertiaryAttribute":null,"Payload":{"QuestionText":"What is your gender?","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"What is your gender?","Choices":{"1":{"Display":"male"},"2":{"Display":"female"}},"ChoiceOrder":[1,2],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"RecodeValues":{"1":1,"2":2},"GradingData":[],"Language":[],"QuestionText_Unsafe":"What is your gender?","DataExportTag":"Q98","QuestionID":"QID98"}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID99","SecondaryAttribute":"How old are you?","TertiaryAttribute":null,"Payload":{"QuestionText":"How old are you?","DefaultChoices":false,"QuestionType":"Slider","Selector":"HSLIDER","Configuration":{"QuestionDescriptionOption":"UseText","CSSliderMin":10,"CSSliderMax":100,"GridLines":9,"SnapToGrid":false,"NumDecimals":"0","ShowValue":true,"CustomStart":true,"SliderStartPositions":{"1":0},"NotApplicable":false},"QuestionDescription":"How old are you?","Choices":{"1":{"Display":"years"}},"ChoiceOrder":[1],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"Labels":[],"QuestionText_Unsafe":"How old are you?","DataExportTag":"Q99","QuestionID":"QID99"}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"STAT","PrimaryAttribute":"Survey Statistics","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"MobileCompatible":true,"ID":"Survey Statistics"}}]}