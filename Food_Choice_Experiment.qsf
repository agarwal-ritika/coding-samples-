on":{"QuestionDescriptionOption":"UseText","MinSeconds":2,"MaxSeconds":5},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"GradingData":[],"Language":{"DE":{"QuestionText":"Zeitmessung"}},"DataVisibility":{"Private":false,"Hidden":false},"NextChoiceId":129,"NextAnswerId":1,"DisplayLogic":{"0":{"0":{"LogicType":"EmbeddedField","LeftOperand":"reminderCounter","Operator":"NotEqualTo","RightOperand":"4","Type":"Expression","Description":"<span class=\"ConjDesc\">If<\/span>  <span class=\"LeftOpDesc\">reminderCounter<\/span> <span class=\"OpDesc\">Is Not Equal to<\/span> <span class=\"RightOpDesc\"> 4 <\/span>"},"Type":"If"},"Type":"BooleanExpression","inPage":false},"QuestionText_Unsafe":"Timing","DataExportTag":"Q426","QuestionID":"QID426"}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID427","SecondaryAttribute":"Remember to make\u00a0healthy\u00a0choices.","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\"><strong style=\"font-size: 22px; text-align: center;\">Remember to make&nbsp;<u><span style=\"color: rgb(0, 204, 51);\">healthy<\/span><\/u>&nbsp;choices.<\/strong><\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Remember to make\u00a0healthy\u00a0choices.","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":{"DE":{"QuestionText":"<div style=\"text-align: center;\"> <strong style=\"font-size: 22px; text-align: center;\">Denken Sie daran, <u><span style=\"color: rgb(0, 204, 51);\">gesunde<\/span><\/u> Entscheidungen zu treffen.<\/strong> <\/div>"}},"DataVisibility":{"Private":false,"Hidden":false},"DisplayLogic":{"0":{"0":{"LogicType":"EmbeddedField","LeftOperand":"reminderCounter","Operator":"NotEqualTo","RightOperand":"4","Type":"Expression","Description":"<span class=\"ConjDesc\">If<\/span>  <span class=\"LeftOpDesc\">reminderCounter<\/span> <span class=\"OpDesc\">Is Not Equal to<\/span> <span class=\"RightOpDesc\"> 4 <\/span>"},"Type":"If"},"Type":"BooleanExpression","inPage":false},"NextChoiceId":1,"NextAnswerId":1,"QuestionText_Unsafe":"<div style=\"text-align: center;\"><strong style=\"font-size: 22px; text-align: center;\">Remember to make&nbsp;<u><span style=\"color: rgb(0, 204, 51);\">healthy<\/span><\/u>&nbsp;choices.<\/strong><\/div>","DataExportTag":"Q427","QuestionID":"QID427"}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID428","SecondaryAttribute":"Debriefing We would like to debrief you about the tasks and questionnaires that you have performe...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\">\n<div><span style=\"font-size:16px;\"><strong>Debriefing<\/strong><\/span><\/div>\n\n<div style=\"text-align: left;\"><br \/>\n<span style=\"font-size:16px;\">We would like to debrief you about the tasks and questionnaires that you have performed. The aim of this study was to test how the current COVID19 pandemic affects your feelings of stress and anxiety and through it how you make decisions in different contexts.&nbsp;<br \/>\n<br \/>\nPrevious studies have shown that crises and traumatic environmental events negatively affect our emotional balance, especially when news speaks heavily about death risks. Stress and fear also have a negative impact on our ability to make everyday decisions. In this study, we specifically tested how you evaluate different daily objects and your budgeting preferences. There was no deception in the tasks.&nbsp;<br \/>\n<br \/>\nYou can check out these relevant studies to learn more information:&nbsp;<\/span><br \/>\n<br \/>\n<span style=\"font-size:16px;\">&bull;&nbsp;&nbsp; &nbsp;Porcelli, A., Delgado, M. (2016). Stress and decision making: effects on valuation, learning, and risk-taking Current Opinion in Behavioral Sciences 14, 33 - 39.&nbsp;<br \/>\n&bull;&nbsp;&nbsp; &nbsp;Griskevicius, V., Tybur, J. M., Delton, A. W., &amp; Robertson, T. E. (2011). The influence of mortality and socioeconomic status on risk and delayed rewards: a life history theory approach. Journal of Personality and Social Psychology, 100(6), 1015.&nbsp;<br \/>\n&bull;&nbsp;&nbsp; &nbsp;Ferraro, R., Shiv, B., Bettman, J. (2005). Let Us Eat and Drink, for Tomorrow We Shall Die: Effects of Mortality Salience and Self\u2010Esteem on Self\u2010 Regulation in Consumer Choice, Journal of Consumer Research 32 (1), 65-75.&nbsp;<br \/>\n<br \/>\nIf you have any questions about this study, please contact Dr. Hilke Plassmann, plassmann.lab@gmail.com&nbsp;<\/span><\/div>\n\n<div style=\"text-align: left;\">&nbsp;<\/div>\n\n<div style=\"text-align: left;\"><u><strong><font size=\"3\">In the next page, we are going to run an algorithm to select a trial to pay you the bonus. Please continue to the next page. &nbsp; &nbsp;<\/font><\/strong><\/u><\/div>\n<\/div>\n\n<div style=\"text-align: left;\">&nbsp;<\/div>","DefaultChoices":false,"DataExportTag":"Q428","QuestionID":"QID428","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Debriefing We would like to debrief you about the tasks and questionnaires that you have performe...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID429","SecondaryAttribute":"In this questionnaire, please indicate the likelihood that you would engage in the described acti...","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-size:16px;\">In this questionnaire, please <u><strong>indicate the likelihood that you would engage in the described activity or behaviour if you were to find yourself in that situation<\/strong><\/u>. Rate from Extremely Unlikely to Extremely Likely. There are no right or wrong answers.&nbsp;<\/span>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"In this questionnaire, please indicate the likelihood that you would engage in the described acti...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":1,"NextAnswerId":1,"QuestionText_Unsafe":"In this questionnaire, please indicate the likelihood that you would engage in the described activity or behaviour if you were to find yourself in that situation. Rate from Extremely Unlikely to Extremely Likely. There are no right or wrong answers.&nbsp;","DataExportTag":"Q429","QuestionID":"QID429"}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID43","SecondaryAttribute":"I would jump in surprise at the least thing","TertiaryAttribute":null,"Payload":{"QuestionText":"I would jump in surprise at the least thing","DefaultChoices":false,"DataExportTag":"Q8","QuestionID":"QID43","QuestionType":"Slider","Selector":"HSLIDER","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","CSSliderMin":0,"CSSliderMax":5,"GridLines":5,"SnapToGrid":false,"NumDecimals":"0","ShowValue":true,"CustomStart":false,"NotApplicable":false,"MobileFirst":true},"QuestionDescription":"I would jump in surprise at the least thing","Choices":{"1":{"Display":"&nbsp;"}},"ChoiceOrder":[1],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":2,"NextAnswerId":7,"Labels":{"1":{"Display":"0=not experienced"},"6":{"Display":"5=very often experienced"}}}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID430","SecondaryAttribute":"Admitting that your tastes are different from th