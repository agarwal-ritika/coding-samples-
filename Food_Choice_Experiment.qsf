ad.eu.qualtrics.com\/ControlPanel\/Graphic.php?IM=IM_8pjlx3cgXetBUTb\",\n\t\t\"https:\/\/insead.eu.qualtrics.com\/ControlPanel\/Graphic.php?IM=IM_3jCk9kT1vqNeU9T\",\n\t\t\"https:\/\/insead.eu.qualtrics.com\/ControlPanel\/Graphic.php?IM=IM_cZJL86hhEs3yK8t\",\n\t\t\"https:\/\/insead.eu.qualtrics.com\/ControlPanel\/Graphic.php?IM=IM_3vK1EtRILRAKOSp\",\n\t\t\"https:\/\/insead.eu.qualtrics.com\/ControlPanel\/Graphic.php?IM=IM_2tSzmGDTVuqg6vH\",\n\t\t\"https:\/\/insead.eu.qualtrics.com\/ControlPanel\/Graphic.php?IM=IM_ePYKpt5dhyMSmYR\",\n\t\t\"https:\/\/insead.eu.qualtrics.com\/ControlPanel\/Graphic.php?IM=IM_byAVAlUANe7hIAl\",\n\t\t\"https:\/\/insead.eu.qualtrics.com\/ControlPanel\/Graphic.php?IM=IM_efkPm9pdOEMW7Q1\"];\n\n\tQualtrics.SurveyEngine.setEmbeddedData('foodChoiceImageArray',foodChoiceImageArray);\n\t\n\tvar nFoods = 24;\n\t\n\tvar hfIndexNoSC =[];\n\tvar hfIndexYesSC =[];\t\n\tvar uhfIndexNoSC = [];\n\tvar uhfIndexYesSC =[];\n\n\t\/\/ Extract the HR and TR for each participant from embedded field\n\tvar myH = \"${e:\/\/Field\/hrRatings}\";\n\tvar h = myH.split(',');\n\tvar myT = \"${e:\/\/Field\/trRatings}\";\n\tvar t = myT.split(',');\n\t\n\t\/\/Creating the pairings of the SC task and no SC task based on ratings.\n\tfor (var i  = 0; i<h.length; i++) {\n\t\tfor (var j = i+1; j<t.length; j++){\n\t\t\tvar h_i = h[i];\n\t\t\tvar h_j = h[j];\n\t\t\tvar t_i = t[i];\n\t\t\tvar t_j = t[j];\n\t\t\tif (h_i>h_j) {\n\t\t\t\tif (t_i>t_j) {\n\t\t\t\t\thfIndexNoSC.push(i);\n\t\t\t\t\tuhfIndexNoSC.push(j);\n\t\t\t\t} else if (t_i<t_j) {\n\t\t\t\t\tuhfIndexYesSC.push(i);\n\t\t\t\t\thfIndexYesSC.push(j);\n\t\t\t\t}\n\t\t\t} else if (h_i<h_j) {\n\t\t\t\tif (t_i>t_j) {\n\t\t\t\t\tuhfIndexYesSC.push(j);\n\t\t\t\t\thfIndexYesSC.push(i);\n\t\t\t\t} else if (t_i<t_j) {\n\t\t\t\t\thfIndexNoSC.push(j);\n\t\t\t\t\tuhfIndexNoSC.push(i);\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\t\t\n\tQualtrics.SurveyEngine.setEmbeddedData('h',h);\n\tQualtrics.SurveyEngine.setEmbeddedData('t',t);\n\t\n\tQualtrics.SurveyEngine.setEmbeddedData('uhfIndexNoSC',uhfIndexNoSC);\n\tQualtrics.SurveyEngine.setEmbeddedData('uhfIndexYesSC',uhfIndexYesSC);\n\tQualtrics.SurveyEngine.setEmbeddedData('hfIndexNoSC',hfIndexNoSC);\n\tQualtrics.SurveyEngine.setEmbeddedData('hfIndexYesSC',hfIndexYesSC);\n\n});\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\t\/*Place your JavaScript here to run when the page is fully displayed*\/\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});","DataVisibility":{"Private":false,"Hidden":false},"NextChoiceId":1,"NextAnswerId":1,"QuestionText_Unsafe":"You may take a minute to stretch your legs. When ready, please click the arrow button to continue.","DataExportTag":"Q319","QuestionID":"QID319"}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID32","SecondaryAttribute":"The\u00a0above\u00a0information about COVID-19 made me feel frightened by the idea that all my thoughts and.","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-size:16px;\">The&nbsp;above&nbsp;information about COVID-19 made me feel frightened by the idea that all my thoughts and feelings would stop when I am dead<\/span><br \/>\n&nbsp;","DefaultChoices":false,"QuestionType":"Slider","Selector":"HSLIDER","Configuration":{"QuestionDescriptionOption":"UseText","CSSliderMin":1,"CSSliderMax":9,"GridLines":8,"SnapToGrid":false,"NumDecimals":0,"ShowValue":true,"CustomStart":true,"NotApplicable":false,"MobileFirst":true,"SliderStartPositions":{"1":0.5011655011655011815463467428344301879405975341796875}},"QuestionDescription":"The\u00a0above\u00a0information about COVID-19 made me feel frightened by the idea that all my thoughts and...","Choices":{"1":{"Display":""}},"ChoiceOrder":[1],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":2,"NextAnswerId":3,"Labels":{"1":{"Display":"1=strongly disagree"},"2":{"Display":"9=strongly agree"}},"DataVisibility":{"Private":false,"Hidden":false},"QuestionText_Unsafe":"The information about COVID-19 made me feel frightened by the idea that all my thoughts and feelings would stop when I am dead&nbsp;","DataExportTag":"DAS4","QuestionID":"QID32"}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID320","SecondaryAttribute":"In this next task, you will be asked to choose between two snacks. Please try to choose the healt...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><span style=\"font-size:16px;\">In this next task, you will be asked to <u>choose between two snacks. Please try to choose the <\/u><strong>healthier snack<\/strong>.<br \/>\n<br \/>\nYou will be asked to choose a snack that you would like to eat at the end of the experiment. If this task is chosen by the computer, you will actually receive the food item from us within the delay of shipping it to you.<\/span><\/p>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"In this next task, you will be asked to choose between two snacks. Please try to choose the healt...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":{"DE":{"QuestionText":"<p><u>In dieser n\u00e4chsten Aufgabe werden Sie aufgefordert, zwischen zwei Snacks zu w\u00e4hlen, mit dem Ziel, den ges\u00fcnderen Snack auszuw\u00e4hlen.<\/u>&nbsp;<\/p><p>&nbsp;<\/p><p>Sie k\u00f6nnen den ausgew\u00e4hlten Snack entweder <u>heute<\/u> oder aber nach dem zweiten Studientermin <u>in einer Woche<\/u> essen.&nbsp;<\/p><p>Bitte denken Sie daran, dass eine dieser Entscheidungen nach dem Zufallsprinzip gezogen werden kann und Sie den von Ihnen gew\u00e4hlten Snack in dieser Entscheidung erhalten.<o:p><\/o:p><\/p>"}},"PrivateData":false,"QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n\t\/*Place your JavaScript here to run when the page loads*\/\n\t\n\t\/\/ Generate an array of random numbers based on the length of each condition (Yes or No SC) \n\t\/\/ Draw without replacement until a limit. For example if numNeeded is 15, countLimit = 30, it draws 15 unique random numbers strictly less than 30 and inclusive of 0\n\tvar nFoods = 10;\n\tvar yesSCarr = \"${e:\/\/Field\/hfIndexYesSC}\".split(',');\n\tvar nYesSC = yesSCarr.length;\n\tvar orderingYesSC = [];\n\tvar nYesSCarr = [];\n\t\n\tvar reminderCounter = 0;\n\tQualtrics.SurveyEngine.setEmbeddedData('reminderCounter',reminderCounter);\n\n\tfor (var i=0;i<nYesSC;i++) {\n  \t\tnYesSCarr.push(i);\n\t}\n\t\n\tfor (var i=0;i<nFoods; i++) {\n\t\tvar rand = Math.floor(Math.random()*nYesSC);\n\t\tvar myElement = nYesSCarr[rand];\n\t\torderingYesSC.push(myElement);\n\t\tnYesSCarr.splice(rand,1);\n\t\tnYesSC--;\t\t\t\n\t}\n\t\n\tvar noSCarr =  \"${e:\/\/Field\/hfIndexNoSC}\".split(',');\n\tvar nNoSC = noSCarr.length;\n\tvar orderingNoSC = [];\n\tvar nNoSCarr = [];\n\t\n\tconsole.log(noSCarr);\n\t\n\tfor (var i=0;i<nNoSC;i++) {\n  \t\tnNoSCarr.push(i);\n\t}\n\t\n\tfor (var i=0;i<nFoods; i++) {\n\t\tvar rand = Math.floor(Math.random()*nNoSC);\n\t\tvar myElement = nNoSCarr[rand];\n\t\torderingNoSC.push(myElement);\n\t\tnNoSCarr.splice(rand,1);\n\t\tnNoSC--;\t\t\t\n\t}\n\t\n\t\n\tQualtrics.SurveyEngine.setEmbeddedData('yesSCarr', yesSCarr);\n\tQualtrics.SurveyEngine.setEmbeddedData('orderingNoSC', orderingNoSC);\n\tQualtrics.SurveyEngine.setEmbeddedData('orderingYesSC', orderingYesSC);\n\n});\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\t\/*Place your JavaScript here to run when the page is fully displayed*\/\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n});","DataVisibility":{"Private":false,"Hidden":false},"NextChoiceId":1,"NextAnswerId":1,"QuestionText_Unsafe":"<p>In this next task, you will be asked to <u>choose between two snacks with the goal of choosing the healthier snack.<\/u><\/p>\n\n<p>&nbsp;<\/p>\n\n<p>You will be asked to choose a snack that you would, hypothetically, like to eat after the experiment <u>today.<\/u><\/p>","DataExportTag":"Q320","QuestionID":"QID320"}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID321","SecondaryAttribute":"Which would you prefer to eat at the end of the experiment today?","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\"><span style=\"font-size:16px;\">Which would you prefer to eat at the end of the experiment <strong>today<\/strong>?<\/span><\/div>","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Which would you prefer to eat at the end of the experiment today?","Choices":{"1":{"Display":"<div style=\"text-align: center;\"><img height=\"300\" id=\"FoodChoiceNoSCNow01hf\" src=\"https:\/\/tinyurl.com\/INSEADurlExp\"style=\"width: 240px; height: 300px;\" width=\"240\"><\/div>"},"2":{"Display":"<div style=\"text-align: center;\"><img height=\"300\" id=\"FoodChoiceNoSCNow01uhf\" src=\"https:\/\/tinyurl.com\/INSEADurlExp\"style=\"width: 240px; height: 300px;\" width=\"240\"><\/div>"}},"ChoiceOrder":[1,2],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":{"DE":{"QuestionText":"<div>Was w\u00fcrden Sie <b>heute<\/b> lieber essen?<\/div>","Choices":{"1":{"Display":"<img id=\"FoodChoiceNoSCNow01hf\" src=\"https:\/\/tinyurl.com\/INSEADurlExp\" height = \"200px\"\/>"},"2":{"Display":"<img id=\"FoodChoiceNoSCNow01uhf\" src=\"https:\/\/tinyurl.com\/INSEADurlExp\" height = \"200px\"\/>"}}}},"QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n\t\/*Place your JavaScript here to run when the page loads*\/\n\tvar $j = jQuery.noConflict();\n\tvar reminderCounter = parseInt(\"${e:\/\/Field\/reminderCounter}\");\n\treminderCounter = reminderCounter+1;\n\tQualtrics.SurveyEngine.setEmbed