":"UseText","InputWidth":460,"InputHeight":29},"QuestionDescription":"What is the death rate of COVID-19 mentioned in the text above?","Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID497","SecondaryAttribute":"What is the probabilty to develop severe symptoms mentioned in the text above?","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-family:Arial,Helvetica,sans-serif;\"><span style=\"font-size:16px;\">What is the probabilty to develop severe symptoms mentioned in the text above?<\/span><\/span>","DefaultChoices":false,"DataExportTag":"Q497","QuestionID":"QID497","QuestionType":"TE","Selector":"SL","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"What is the probabilty to develop severe symptoms mentioned in the text above?","Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID498","SecondaryAttribute":"Describe briefly how you felt and what your thoughts were while you were infected with the corona...","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-size:16px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">Describe briefly how you felt and what your thoughts were while you were infected with the coronavirus!<\/span><\/span>","DefaultChoices":false,"DataExportTag":"Q498","QuestionType":"TE","Selector":"ML","Configuration":{"QuestionDescriptionOption":"UseText","InputWidth":642,"InputHeight":79},"QuestionDescription":"Describe briefly how you felt and what your thoughts were while you were infected with the corona...","Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID498","DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID499","SecondaryAttribute":"What is the survival rate of COVID-19 mentioned in the text above?","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-size:16px;\">What is the survival rate of COVID-19 mentioned in the text above?<\/span>","DefaultChoices":false,"DataExportTag":"Q499","QuestionID":"QID499","QuestionType":"TE","Selector":"SL","Configuration":{"QuestionDescriptionOption":"UseText","InputWidth":473,"InputHeight":29},"QuestionDescription":"What is the survival rate of COVID-19 mentioned in the text above?","Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID5","SecondaryAttribute":"The next scale consists of a number of words that describe different feelings and emotions. Indic...","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-size:16px;\">The next scale consists of a number of words that describe different feelings and emotions. <u><strong>Indicate to what extent you feel this way right now<\/strong><\/u>.&nbsp;There are no right or wrong answers.<\/span>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"The next scale consists of a number of words that describe different feelings and emotions. Indic...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"QuestionText_Unsafe":"This scale consists of a number of words that describe different feelings and emotions. Read each item and then list the number from the scale below next to each word.&nbsp;<div><br><\/div><div>Indicate to what extent you feel this way right now, that is, at the present moment OR indicate the extent you have felt this way over the past week.&nbsp;<\/div>","DataExportTag":"instructions","QuestionID":"QID5","DataVisibility":{"Private":false,"Hidden":false},"NextChoiceId":1,"NextAnswerId":1}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID50","SecondaryAttribute":"I had a bodily reaction when exposed to reminders of COVID-19","TertiaryAttribute":null,"Payload":{"QuestionText":"I had a bodily reaction when exposed to reminders of COVID-19","DefaultChoices":false,"DataExportTag":"Q15","QuestionID":"QID50","QuestionType":"Slider","Selector":"HSLIDER","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","CSSliderMin":0,"CSSliderMax":5,"GridLines":5,"SnapToGrid":false,"NumDecimals":"0","ShowValue":true,"CustomStart":false,"NotApplicable":false,"MobileFirst":true},"QuestionDescription":"I had a bodily reaction when exposed to reminders of COVID-19","Choices":{"1":{"Display":"&nbsp;"}},"ChoiceOrder":[1],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":2,"NextAnswerId":7,"Labels":{"1":{"Display":"0=not experienced"},"6":{"Display":"5=very often experienced"}}}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID500","SecondaryAttribute":"What is the probabilty to develop only mild symptoms and reciver fully mentioned in the text above?","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-family:Arial,Helvetica,sans-serif;\"><span style=\"font-size:16px;\">What is the probabilty to develop only mild symptoms and reciver fully mentioned in the text above?<\/span><\/span>","DefaultChoices":false,"DataExportTag":"Q500","QuestionType":"TE","Selector":"SL","Configuration":{"QuestionDescriptionOption":"UseText","InputWidth":652,"InputHeight":29},"QuestionDescription":"What is the probabilty to develop only mild symptoms and reciver fully mentioned in the text above?","Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID500","DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID501","SecondaryAttribute":"Describe briefly how you felt and what your thoughts were while you were infected with the corona...","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-size:16px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">Describe briefly how you felt and what your thoughts were while you were infected with the coronavirus!<\/span><\/span>","DefaultChoices":false,"DataExportTag":"Q501","QuestionID":"QID501","QuestionType":"TE","Selector":"ML","Configuration":{"QuestionDescriptionOption":"UseText","InputWidth":637,"InputHeight":85},"QuestionDescription":"Describe briefly how you felt and what your thoughts were while you were infected with the corona...","Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID502","SecondaryAttribute":"Please read carefully the information below: According to the World Health Organization (WHO) the...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><span style=\"font-size:16px;\">Please read carefully the information below:<br>\n<br>\nAccording to the World Health Organization (WHO) the coronavirus (COVID-19) is contagious pneumonia of unknown cause with acute outbreaks around the world at this time. There is currently no vaccine or specific antiviral treatment.&nbsp;<\/span><\/p><p><span style=\"font-size:16px;\"><br><\/span><\/p><p><span style=\"font-size:16px;\">According to WHO, globally, more than 8 million cases of COVID-19 have been reported and 4 million people who suffered from the virus have recovered from the illness. In France, WHO has reported over 158,000 confirmed cases and more than 73,000 people have recovered so far.&nbsp;<strong>If you get infected with COVID-19, there is 80% chance that you would have mild illness and make a full recovery within a few weeks. The survival rate of COVID-19 is 81%.<\/strong><\/span><\/p>","DefaultChoices":false,"DataExportTag":"s1 low salience","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please read carefully the information below: According to the World Health Organization (WHO) the...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID502","DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID503","SecondaryAttribute":"What is the survival rate of COVID-19 mentioned in the text above?","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"caret-color: rgb(0, 0, 0); color: rgb(0, 0, 0); font-size: 16px;\">What is the survival rate of COVID-19 mentioned in the text above?<\/span>","DefaultChoices":false,"DataExportTag":"Q503","QuestionID":"QID503","QuestionType":"TE","Selector":"SL","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"What is the survival rate of COVID-19 mentioned in the text above?","Validation":{"Settings":{"ForceResponse":"ON","ForceResponse