HPqAYaLyL8ix","ScoringSummaryCategory":null,"ScoringSummaryAfterQuestions":0,"ScoringSummaryAfterSurvey":0,"AutoScoringCategory":null}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SO","PrimaryAttribute":"Survey Options","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"BackButton":"false","SaveAndContinue":"true","SurveyProtection":"PublicSurvey","BallotBoxStuffingPrevention":"false","NoIndex":"Yes","SecureResponseFiles":"true","SurveyExpiration":null,"SurveyTermination":"DefaultMessage","Header":"","Footer":"","ProgressBarDisplay":"None","PartialData":"+1 week","ValidationMessage":null,"PreviousButton":" \u2190 ","NextButton":" \u2192 ","SurveyTitle":"Online Survey Software | Qualtrics Survey Solutions","SkinLibrary":"insead","SkinType":"MQ","Skin":"insead4_2018_noheader","NewScoring":1,"ShowExportTags":"false","CollectGeoLocation":"false","SurveyMetaDescription":"Qualtrics sophisticated online survey software solutions make creating online surveys easy. Learn more about Research Suite and get a free account today.","PasswordProtection":"No","AnonymizeResponse":"No","Password":"","RefererCheck":"No","RefererURL":"http:\/\/","UseCustomSurveyLinkCompletedMessage":null,"SurveyLinkCompletedMessage":"","SurveyLinkCompletedMessageLibrary":"","ResponseSummary":"No","EOSRedirectURL":"https:\/\/","EmailThankYou":"false","ThankYouEmailMessageLibrary":null,"ThankYouEmailMessage":null,"ValidateMessage":"false","ValidationMessageLibrary":null,"InactiveSurvey":"DefaultMessage","PartialDataCloseAfter":"LastActivity","ActiveResponseSet":null,"InactiveMessageLibrary":"","InactiveMessage":"","AvailableLanguages":{"EN":[]},"SurveyName":"Food Choice Experiment"}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID1","SecondaryAttribute":"This is the third set of tasks and questionnaires.\u00a0Please use your computer\u00a0(more preferred devic.","TertiaryAttribute":null,"Payload":{"QuestionText":"<font size=\"3\">This is the <\/font><u style=\"font-size: 16px;\"><strong>third<\/strong><\/u><font size=\"3\"> set of tasks and questionnaires.&nbsp;<\/font><br>\n<br>\n<strong style=\"font-size: 16px;\">Please use your <span style=\"color:#3498db;\">computer<\/span>&nbsp;(more preferred device) or <span style=\"color:#2ecc71;\">smartphone<\/span> (the screen size MUST be larger than 5 inches) to do this survey. <span style=\"color:#c0392b;\">Do NOT use tablets (e.g., iPad) because the system is incompatible with this survey.<\/span><\/strong><br><font size=\"3\">\n&nbsp;<\/font><br><font size=\"3\">\nYou should start the tests as soon as you can <\/font><strong style=\"font-size: 16px;\"><u>between 16:00-21:00 your local time<\/u><\/strong><font size=\"3\">. <\/font><strong style=\"font-size: 16px;\">Make sure that you won\u2019t be interrupted by other things while you are doing the task in the next 40 minutes.&nbsp;<\/strong><br>\n<br>\n<u><strong><font size=\"3\">At the end of this survey, we will&nbsp;debrief you about this study. The computer will then determine one of your choices that you made (include the choices you are going to make in this survey) to&nbsp;pay you the bonus.&nbsp;<\/font><\/strong><\/u><br><font size=\"3\">\n&nbsp;<\/font>","DefaultChoices":false,"DataExportTag":"Instruction","QuestionID":"QID1","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"This is the third set of tasks and questionnaires.\u00a0Please use your computer\u00a0(more preferred devic...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":3,"NextAnswerId":1}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID10","SecondaryAttribute":"Strong","TertiaryAttribute":null,"Payload":{"QuestionText":"Strong","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Strong","Choices":{"1":{"Display":"Very Slightly or Not at All"},"2":{"Display":"A Little "},"3":{"Display":"Moderately "},"4":{"Display":"Quite a Bit "},"5":{"Display":"Extremely"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"GradingData":[{"ChoiceID":1,"Grades":{"SC_9uAHPqAYaLyL8ix":1},"index":0},{"ChoiceID":2,"Grades":{"SC_9uAHPqAYaLyL8ix":2},"index":1},{"ChoiceID":3,"Grades":{"SC_9uAHPqAYaLyL8ix":3},"index":2},{"ChoiceID":4,"Grades":{"SC_9uAHPqAYaLyL8ix":4},"index":3},{"ChoiceID":5,"Grades":{"SC_9uAHPqAYaLyL8ix":5},"index":4}],"QuestionText_Unsafe":"Strong","DataExportTag":"Q5","QuestionID":"QID10","DataVisibility":{"Private":false,"Hidden":false},"NextChoiceId":6,"NextAnswerId":1}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID100","SecondaryAttribute":"Thanks for participating!\nPlease copy and paste the following Qualtrics Code to Mechanical\nTurk t...","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-size:16px;\">Thanks for participating!<br>\n<br>\nPlease copy and paste the following Qualtrics Code to Mechanical Turk to receive credit: HP362499<br>\n<br>\nIn case you won the $1 in the lottery you will receive $1 as a bonus payment during the next days.<br>\n<br>\nPlease click \"&gt;&gt;\" to complete this survey and return to Mechanical Turk. (It may take a few moments to save your responses).<\/span>","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Thanks for participating!\nPlease copy and paste the following Qualtrics Code to Mechanical\nTurk t...","Choices":[],"ChoiceOrder":[],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"Language":[],"QuestionText_Unsafe":"<span style=\"font-size:16px;\">Thanks for participating!<br>\n<br>\nPlease copy and paste the following Qualtrics Code to Mechanical Turk to receive credit: HP362499<br>\n<br>\nIn case you won the $1 in the lottery you will receive $1 as a bonus payment during the next days.<br>\n<br>\nPlease click \"&gt;&gt;\" to complete this survey and return to Mechanical Turk. (It may take a few moments to save your responses).<\/span>","DataExportTag":"Q100","QuestionID":"QID100"}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID101","SecondaryAttribute":"In this part of the study we are interested in your\n\n \u201cFood\n Preferences\u201d\n\n \u00a0\n\n Most modern the","TertiaryAttribute":null,"Payload":{"QuestionText":"<style type=\"text\/css\">.Skin #Buttons {\nvisibility:hidden;\n}\n<\/style>\n<p style=\"text-align: center;\">In this part of the study we are interested in your<\/p>\n\n<p style=\"text-align: center;\"><a href=\"#1\" onclick=\"Qualtrics.SurveyEngine.navClick(event, 'NextButton')\">\u201cFood Preferences\u201d<\/a><\/p>\n\n<p>&nbsp;<\/p>\n\n<p style=\"text-align: center;\">Most modern theories of consumption recognize the fact that decisions do not take place in a vacuum. Individual preferences and knowledge, along with situational variables can greatly impact the decision process. In order to facilitate our research on food consumption we are interested in knowing certain factors about you, the consumer. Specifically we are interested in whether you actually take time to read the directions; if not, then some of our manipulations that rely on changes in the instructions will be ineffective. So, in order to demonstrate that you have read the instructions, please ignore the the link above and most of the different foods listed below. Instead, simply click \"Evian\" from the option below. Thank you very much.<\/p>","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n\/*Place Your Javascript Below This Line*\/\nthis.questionclick = function(event,element){ \n\/\/ \nif (element.type == 'checkbox') \n{ \nthis.clickNextButton();\n} \n}\n});","QuestionType":"MC","Selector":"MAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"In this part of the study we are interested in your\n\n \u201cFood\n Preferences\u201d\n\n \u00a0\n\n Most modern theor...","Choices":{"1":{"Display":"MM's"},"2":{"Display":"Jelly Beans"},"3":{"Display":"Hershey's Kisses"},"4":{"Display":"Coca Cola"},"5":{"Display":"Evian"},"6":{"Display":"Pepsi"}},"ChoiceOrder":[1,2,3,4,5,6],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"Language":[],"QuestionText_Unsafe":"<style type=\"text\/css\">.Skin #Buttons {\nvisibility:hidden;\n}\n<\/style>\n<p style=\"text-align: center;\">In this part of the study we are interested in your<\/p>\n\n<p style=\"text-align: center;\"><a href=\"#1\" onclick=\"Qualtrics.SurveyEngine.navClick(event, 'NextButton')\">\u201cFood Preferences\u201d<\/a><\/p>\n\n<p>&nbsp;<\/p>\n\n<p style=\"text-align: center;\">Most modern theories of consumption recognize the fact that decisions do not take place in a vacuum. Individual preferences and knowledge, along with situational variables can greatly impact the decision process. In order to facilitate our research on food consumption we are interested in knowing certain factors about you, the consumer. Specifically we are interested in whether you actually take time to read the directions; if not, then some of our manipulations that rely on changes in the instructions will be ineffective. So, in order to demonstrate that you have read the instructions, please ignore the the link above and most of the different foods listed below. Instead, simply click \"Evian\" from the option below. Thank you very much.<\/p>","DataExportTag":"Q101","QuestionID":"QID101"}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID102","SecondaryAttribute":"In this first study, we are interested in your cognitive abilities. We will ask you three differe...","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-size:16px;\">In this first study, we are interested in your <strong>cognitive abilities<\/strong>. We will ask you three different quiz questions.<br>\n<br>\nIf you answer at least two of them correctly, you qualify to participate in a lottery. In this lottery, <strong>you have 50% chance of winning an extra US$1.00 or a 50% chance winning nothing<\/strong>.<br>\n<br>\nNote that you will indeed win US$1.00\/US$0.00 at the end of the experiments when you have finished your HIT as a bonus payment and that your gain or loss is not hypothetical but <strong>for real<\/strong>.<\/span><br>\n&nbsp;\n<p>&nbsp;<\/p>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"In this first study, we are interested in your cognitive abilities. We will ask you three differe...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"QuestionText_Unsafe":"<span style=\"font-size:16px;\">In this first study, we are interested in your <strong>cognitive abilities<\/strong>. We will ask you three different quiz questions.<br>\n<br>\nIf you answer at least two of them correctly, you qualify to participate in a lottery. In this lottery, <strong>you have 50% chance of winning an extra US$1.00 or a 50% chance winning nothing<\/strong>.<br>\n<br>\nNote that you will indeed win US$1.00\/US$0.00 at the end of the experiments when you have finished your HIT as a bonus payment and that your gain or loss is not hypothetical but <strong>for real<\/strong>.<\/span><br>\n&nbsp;\n<p>&nbsp;<\/p>","DataExportTag":"Q102","QuestionID":"QID102","DataVisibility":{"Private":false,"Hidden":false},"NextChoiceId":1,"NextAnswerId":1}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID103","SecondaryAttribute":"In the next part, we will ask you to look at 6 different pictures. The pictures include animals,...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><span style=\"font-size:16px;\">In the next part, we will ask you to look at 6 different pictures. The pictures include animals, objects and scary or&nbsp;<\/span><span style=\"font-size: 16px;\">unpleasant<\/span><span style=\"font-size:16px;\">&nbsp;situations. We are interested in <strong>how much you enjoy looking at these different pictures.<\/strong><\/span><\/p>\n\n<p>&nbsp;<\/p>\n\n<p><span style=\"font-size:16px;\">Please view these pictures and use a scale from 1 (not at all) to 9 (very much) to rate your liking of this picture.&nbsp;<\/span><\/p>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"In the next part, we will ask you to look at 6 different pictures. The pictures include animals,...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"QuestionText_Unsafe":"<p><span style=\"font-size:16px;\">In the next study we will ask you to look at 6 different pictures. The pictures include animals, objects and scary or&nbsp;<\/span><span style=\"font-size: 16px;\">unpleasant<\/span><span style=\"font-size:16px;\">&nbsp;situations. We are interested in how much you enjoy looking at these different pictures.<\/span><\/p>\n\n<p>&nbsp;<\/p>\n\n<p><span style=\"font-size:16px;\">You will see the picture and then we will ask&nbsp;about how much you enjoy looking at the picture on a scale from 1 (not at all) to 9 (very much).<\/span><\/p>\n\n<p>&nbsp;<\/p>\n\n<p><span style=\"font-size:16px;\"><em>Click on \"&gt;&gt;\" to continue<\/em><\/span><\/p>","DataExportTag":"picture instruction","QuestionID":"QID103","DataVisibility":{"Private":false,"Hidden":false},"NextChoiceId":1,"NextAnswerId":1}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID104","SecondaryAttribute":"A bat and a ball cost $1.10 in total. The bat costs $1.00 more than the ball. How much does the b...","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-size:16px;\">A bat and a ball cost $1.10 in total. The bat costs $1.00 more than the ball.<br \/>\nHow much does the ball cost?<\/span>","DefaultChoices":false,"QuestionType":"TE","Selector":"FORM","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"A bat and a ball cost $1.10 in total. The bat costs $1.00 more than the ball. How much does the b...","Choices":{"1":{"Display":"cents:"}},"ChoiceOrder":[1],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":null}},"GradingData":[],"Language":[],"QuestionText_Unsafe":"A bat and a ball cost $1.10 in total. The bat costs $1.00 more than the ball.<br>\nHow much does the ball cost?","DataExportTag":"CRT1","QuestionID":"QID104","DataVisibility":{"Private":false,"Hidden":false},"NextChoiceId":2,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"}}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID105","SecondaryAttribute":"If it takes 5 machines 5 minutes to make 5 widgets, how long would it take 100 machines to make 1...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><span style=\"font-size:16px;\">If it takes 5 machines 5 minutes to make 5 widgets, how long would it take<br \/>\n100 machines to make 100 widgets?<\/span><\/p>","DefaultChoices":false,"QuestionType":"TE","Selector":"FORM","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"If it takes 5 machines 5 minutes to make 5 widgets, how long would it take 100 machines to make 1...","Choices":{"1":{"Display":"minutes:"}},"ChoiceOrder":[1],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":null}},"GradingData":[],"Language":[],"QuestionText_Unsafe":"<p>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\nIf it takes 5 machines 5 minutes to make 5 widgets, how long would it take<br>\n100 machines to make 100 widgets?<\/p>","DataExportTag":"CRT2","QuestionID":"QID105","DataV