nswerId":8,"Answers":{"4":{"Display":"<div style=\"text-align: center;\">${lm:\/\/Field\/3} &euro;<br \/>\nAND<br \/>\n0 &euro;<\/div>"},"3":{"Display":"<div style=\"text-align: center;\">${lm:\/\/Field\/4} &euro;<br \/>\nAND<br \/>\n${lm:\/\/Field\/8} &euro;<\/div>"},"2":{"Display":"<div style=\"text-align: center;\">${lm:\/\/Field\/5} &euro;<br \/>\nAND<br \/>\n${lm:\/\/Field\/9} &euro;<\/div>"},"5":{"Display":"<div style=\"text-align: center;\">${lm:\/\/Field\/6} &euro;<br \/>\nAND<br \/>\n${lm:\/\/Field\/10} &euro;<\/div>"},"6":{"Display":"<div style=\"text-align: center;\">${lm:\/\/Field\/7} &euro;<br \/>\nAND<\/div>\n\n<div style=\"text-align: center;\">${lm:\/\/Field\/11} &euro;<\/div>"},"7":{"Display":"<div style=\"text-align: center;\">0 &euro;<br \/>\nAND<br \/>\n${lm:\/\/Field\/12} &euro;<\/div>\n"}},"AnswerOrder":["4","3","2","5","6","7"],"ChoiceDataExportTags":false,"QuestionText_Unsafe":"Please select which option you would prefer.","DataExportTag":"CBT choices","QuestionID":"QID198"}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID199","SecondaryAttribute":"The next questionnaire consists of 21 statements. Please read each statement carefully and then p...","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-size:16px;\">The next questionnaire consists of 21 statements. Please read each statement carefully and then pick out the one that best describes the way you have been feeling <strong>during the past two weeks, including today.&nbsp;<\/strong>There is no right or wrong with your answers. &nbsp;<\/span><div><span style=\"font-size:16px;\"><br><\/span><\/div>","DefaultChoices":false,"DataExportTag":"BDI instruction","QuestionID":"QID199","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"The next questionnaire consists of 21 statements. Please read each statement carefully and then p...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_cJ7cUY3T03V4ELk","Element":"SQ","PrimaryAttribute":"QID2","SecondaryAttribute":"Please note these numbers in the text box below and then describe briefly how you would feel and...","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-size:16px;\">Please note these numbers in the text box below and then describe briefly how you would feel and think if you would be infected with the coronavirus?&nbsp;<\/span>\n<div>&nbsp;<\/div>\n\n<div><span style=\"font-size:16px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">According to the World Health Organization (WHO) the coronavirus (COVID-19) is a highly contagious acute pneumonia of unknown cause with acute outbreaks around the world at this time. There is currently no vaccine or specific antiviral treatment. According to the WHO, globally, more than 1.5 million cases of COVID-19 have been reported which have led to over 87,000 deaths. In the United States, CDC has reported 420,000 confirmed cases with over 14,000 deaths. <strong>If you get infected with COVID-19, there is 20% chance that you would develop into severe or critical illness. The death rate of COVID-19 is 2.4%, which is 24 times higher than the death rate of influenza at 0.1%.&nbsp;<\/strong><\/span><\/span><\/div>","DefaultChoices":false,"DataExportTag":"s3 high salience","QuestionID":"QID2","QuestionType":"TE","Selector":"ESTB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","InputWidth":578,"InputHeight":29},"QuestionDescription":"Please note these numbers in the text box below and then describe briefly how you would feel and...","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None","MinChars":"5"}},"GradingData":[],"Language":[],"NextChoiceId":9,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"}}}